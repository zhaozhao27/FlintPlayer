import { Translation } from "translation.slint";
component PromptButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component ShutdownPrompt inherits Rectangle {
    in property <string> message: "";
    in property <string> action-label: "关机";
    callback confirm;
    callback cancel;

    width: 440px;
    height: 158px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 46px;
            height: parent.height;
            text: Translation.tr("收尾处理", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.cancel(); }
        }
    }

    Text {
        x: 20px;
        y: 44px;
        width: parent.width - 40px;
        height: 58px;
        text: root.message;
        color: #1a1a1a;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: center;
    }

    PromptButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: root.action-label;
        primary: true;
        clicked => { root.confirm(); }
    }

    PromptButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.cancel(); }
    }
}
