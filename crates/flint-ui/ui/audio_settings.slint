import { Translation } from "translation.slint";

component DialogHeader inherits Rectangle {
    in property <string> title: "";
    callback close;

    height: 28px;
    background: #1f1f1f;

    Text {
        x: 10px;
        y: 0;
        width: parent.width - 50px;
        height: parent.height;
        text: root.title;
        color: #eeeeee;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 30px;
        y: 0;
        width: 20px;
        height: parent.height;
        text: "✕";
        color: #d0d0d0;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        x: parent.width - 36px;
        y: 0;
        width: 36px;
        height: parent.height;
        clicked => { root.close(); }
    }
}

component DlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 23px;
    background: !root.enabled
        ? #ececec
        : root.active
            ? (ta.has-hover ? #bcdcff : #cfe6ff)
            : (root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4));
    border-width: 1px;
    border-color: root.active ? #4a90d9 : #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component DlgCheck inherits Rectangle {
    in property <string> label: "";
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled;

    height: 20px;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        background: root.enabled ? #ffffff : #ececec;
        border-width: 1px;
        border-color: root.enabled ? #7a7a7a : #bcbcbc;

        Text {
            x: 0;
            y: -2px;
            width: parent.width;
            height: parent.height;
            text: "✓";
            color: root.enabled ? #1a5fa8 : #9a9a9a;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            visible: root.checked;
        }
    }

    Text {
        x: 19px;
        y: 0;
        width: parent.width - 19px;
        height: parent.height;
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

component DlgSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);

    height: 20px;

    function position() -> float {
        Math.max(0.0, Math.min(1.0, (root.value - root.minimum) / Math.max(0.001, root.maximum - root.minimum)))
    }

    function track(x: length) {
        let ratio = Math.max(0.0, Math.min(1.0, x / Math.max(1px, root.width)));
        let value = root.minimum + ratio * (root.maximum - root.minimum);
        root.value = value;
        root.changed(value);
    }

    Rectangle {
        x: 0;
        y: 8px;
        width: parent.width;
        height: 4px;
        background: #c8c8c8;
        border-radius: 2px;
    }

    Rectangle {
        x: 0;
        y: 8px;
        width: parent.width * root.position();
        height: 4px;
        background: #3a8fd9;
        border-radius: 2px;
    }

    Rectangle {
        x: parent.width * root.position() - self.width / 2;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;
    }

    ta := TouchArea {
        clicked => { root.track(ta.mouse-x); }
        moved => {
            if (ta.pressed) {
                root.track(ta.mouse-x);
            }
        }
    }
}

export component VolumeControlSettings inherits Rectangle {
    in-out property <bool> multi-channel: false;
    in-out property <float> max-volume: 100;
    in-out property <bool> ac3-dts: false;
    in-out property <float> ac3-gain: 6;

    callback apply;
    callback close;

    width: 520px;
    height: 260px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    DialogHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: Translation.tr("音量控制设置", Translation.language-gen);
        close => { root.close(); }
    }

    DlgCheck {
        x: 20px;
        y: 44px;
        width: 260px;
        label: Translation.tr("多通道音量控制", Translation.language-gen);
        checked: root.multi-channel;
        toggled => { root.multi-channel = !root.multi-channel; }
    }

    Text {
        x: 20px;
        y: 78px;
        width: 120px;
        height: 22px;
        text: Translation.tr("最大音量", Translation.language-gen);
        color: root.multi-channel ? #1a1a1a : #9a9a9a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 150px;
        y: 78px;
        width: 70px;
        height: 22px;
        text: Math.round(root.max-volume) + "%";
        color: root.multi-channel ? #1a5fa8 : #8a8a8a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgSlider {
        x: 226px;
        y: 79px;
        width: 274px;
        value <=> root.max-volume;
        minimum: 100;
        maximum: 500;
        changed(v) => { root.max-volume = Math.round(v); }
    }

    DlgCheck {
        x: 20px;
        y: 116px;
        width: 300px;
        label: Translation.tr("开启 AC3/DTS 音量处理", Translation.language-gen);
        checked: root.ac3-dts;
        toggled => { root.ac3-dts = !root.ac3-dts; }
    }

    Text {
        x: 20px;
        y: 150px;
        width: 150px;
        height: 22px;
        text: Translation.tr("AC3/DTS 解码后放大", Translation.language-gen);
        color: root.ac3-dts ? #1a1a1a : #9a9a9a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 176px;
        y: 150px;
        width: 60px;
        height: 22px;
        text: (Math.round(root.ac3-gain * 10) / 10) + " dB";
        color: root.ac3-dts ? #1a5fa8 : #8a8a8a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgSlider {
        x: 242px;
        y: 151px;
        width: 258px;
        value <=> root.ac3-gain;
        minimum: 0;
        maximum: 24;
        changed(v) => { root.ac3-gain = Math.round(v * 10) / 10; }
    }

    Text {
        x: 20px;
        y: 186px;
        width: parent.width - 40px;
        height: 20px;
        text: Translation.tr("音量最大可放大到 500%，过高可能产生削波失真。", Translation.language-gen);
        color: #6a6a6a;
        font-size: 11px;
        vertical-alignment: center;
    }

    DlgButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}

component DDBox inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> selected: -1;
    in property <string> placeholder: "";
    callback toggled;

    height: 22px;
    background: #ffffff;
    border-width: 1px;
    border-color: #9a9a9a;

    Text {
        x: 5px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : root.placeholder;
        color: root.selected >= 0 ? #1a1a1a : #b0b0b0;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 17px;
        width: 11px;
        height: parent.height;
        text: "▾";
        color: #555555;
        font-size: 10px;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

export component AudioOutputSettings inherits Rectangle {
    in property <[string]> default-devices: [];
    in property <[string]> passthrough-devices: [];
    in property <[string]> secondary-devices: [];
    in-out property <int> device-index: 0;
    in-out property <int> passthrough-index: 0;
    in-out property <int> secondary-index: 0;
    in-out property <int> method-index: 0;
    in-out property <int> format-index: 0;
    in-out property <int> rate-index: 0;

    property <int> open-dd: -1;
    property <[string]> open-options: root.open-dd == 0 ? root.default-devices : root.open-dd == 1 ? root.passthrough-devices : root.secondary-devices;

    callback apply;
    callback close;

    width: 580px;
    height: 350px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    DialogHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: Translation.tr("声音输出设置", Translation.language-gen);
        close => { root.close(); }
    }

    Text {
        x: 20px;
        y: 44px;
        width: 156px;
        height: 22px;
        text: Translation.tr("默认输出设备", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DDBox {
        x: 182px;
        y: 44px;
        width: 348px;
        options: root.default-devices;
        selected <=> root.device-index;
        toggled => { root.open-dd = root.open-dd == 0 ? -1 : 0; }
    }

    Text {
        x: 20px;
        y: 80px;
        width: 156px;
        height: 22px;
        text: Translation.tr("直通输出设备", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DDBox {
        x: 182px;
        y: 80px;
        width: 348px;
        options: root.passthrough-devices;
        selected <=> root.passthrough-index;
        toggled => { root.open-dd = root.open-dd == 1 ? -1 : 1; }
    }

    Text {
        x: 20px;
        y: 116px;
        width: 156px;
        height: 22px;
        text: Translation.tr("次输出设备", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DDBox {
        x: 182px;
        y: 116px;
        width: 348px;
        options: root.secondary-devices;
        selected <=> root.secondary-index;
        toggled => { root.open-dd = root.open-dd == 2 ? -1 : 2; }
    }

    Text {
        x: 20px;
        y: 158px;
        width: 110px;
        height: 22px;
        text: Translation.tr("输出方式", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgButton {
        x: 182px;
        y: 158px;
        width: 118px;
        label: Translation.tr("自动选择", Translation.language-gen);
        active: root.method-index == 0;
        clicked => { root.method-index = 0; }
    }

    DlgButton {
        x: 304px;
        y: 158px;
        width: 110px;
        label: "PulseAudio";
        active: root.method-index == 1;
        clicked => { root.method-index = 1; }
    }

    DlgButton {
        x: 418px;
        y: 158px;
        width: 118px;
        label: Translation.tr("空设备(静音)", Translation.language-gen);
        active: root.method-index == 2;
        clicked => { root.method-index = 2; }
    }

    Text {
        x: 20px;
        y: 198px;
        width: 110px;
        height: 22px;
        text: Translation.tr("输出通道", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 182px;
        y: 198px;
        width: 260px;
        height: 22px;
        text: Translation.tr("2/0/0 - 2.0 立体声", Translation.language-gen);
        color: #4a4a4a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 238px;
        width: 110px;
        height: 22px;
        text: Translation.tr("位深", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgButton {
        x: 182px;
        y: 238px;
        width: 96px;
        label: Translation.tr("16 位", Translation.language-gen);
        active: root.format-index == 0;
        clicked => { root.format-index = 0; }
    }

    DlgButton {
        x: 284px;
        y: 238px;
        width: 96px;
        label: Translation.tr("24 位", Translation.language-gen);
        active: root.format-index == 1;
        clicked => { root.format-index = 1; }
    }

    DlgButton {
        x: 386px;
        y: 238px;
        width: 110px;
        label: Translation.tr("32 位浮点", Translation.language-gen);
        active: root.format-index == 2;
        clicked => { root.format-index = 2; }
    }

    Text {
        x: 20px;
        y: 278px;
        width: 110px;
        height: 22px;
        text: Translation.tr("重采样率", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgButton {
        x: 182px;
        y: 278px;
        width: 70px;
        label: Translation.tr("自动", Translation.language-gen);
        active: root.rate-index == 0;
        clicked => { root.rate-index = 0; }
    }

    DlgButton {
        x: 260px;
        y: 278px;
        width: 70px;
        label: "44.1 kHz";
        active: root.rate-index == 1;
        clicked => { root.rate-index = 1; }
    }

    DlgButton {
        x: 338px;
        y: 278px;
        width: 70px;
        label: "48 kHz";
        active: root.rate-index == 2;
        clicked => { root.rate-index = 2; }
    }

    DlgButton {
        x: 416px;
        y: 278px;
        width: 70px;
        label: "96 kHz";
        active: root.rate-index == 3;
        clicked => { root.rate-index = 3; }
    }

    DlgButton {
        x: 494px;
        y: 278px;
        width: 70px;
        label: "192 kHz";
        active: root.rate-index == 4;
        clicked => { root.rate-index = 4; }
    }

    DlgButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
    if (root.open-dd >= 0) : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.open-dd = -1; }
        }

        Rectangle {
            x: 182px;
            y: root.open-dd == 0 ? 66px : (root.open-dd == 1 ? 102px : 138px);
            width: 348px;
            height: root.open-options.length * 20px + 2px;
            background: #ffffff;
            border-width: 1px;
            border-color: #8f8f8f;

            for option[index] in root.open-options : Rectangle {
                y: index * 20px;
                height: 20px;
                width: parent.width;
                background: option-touch.has-hover ? #3a8fd9 : transparent;

                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: option;
                    color: option-touch.has-hover ? #ffffff : #1a1a1a;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                option-touch := TouchArea {
                    clicked => {
                        if (root.open-dd == 0) {
                            root.device-index = index;
                        } else if (root.open-dd == 1) {
                            root.passthrough-index = index;
                        } else {
                            root.secondary-index = index;
                        }
                        root.open-dd = -1;
                    }
                }
            }
        }
    }
}

export component AudioSyncSettings inherits Rectangle {
    in-out property <float> value: 0;

    callback apply;
    callback close;

    width: 440px;
    height: 176px;
    background: #f0f0f0;

    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    DialogHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: Translation.tr("手动调整同步...", Translation.language-gen);
        close => { root.close(); }
    }

    Text {
        x: 20px;
        y: 44px;
        width: 70px;
        height: 22px;
        text: Translation.tr("声音同步", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 96px;
        y: 44px;
        width: 110px;
        height: 22px;
        text: (Math.round(root.value) > 0 ? "+" : "") + Math.round(root.value) + " ms";
        color: #1a5fa8;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgButton {
        x: parent.width - 100px;
        y: 44px;
        width: 80px;
        label: Translation.tr("复位", Translation.language-gen);
        clicked => { root.value = 0; }
    }

    DlgSlider {
        x: 20px;
        y: 88px;
        width: parent.width - 40px;
        value <=> root.value;
        minimum: -2000;
        maximum: 2000;
        changed(v) => { root.value = Math.round(v); }
    }

    DlgButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}

export component AudioGeneralSettings inherits Rectangle {
    in-out property <int> language-index: 0;
    in-out property <bool> select-by-language: false;
    in-out property <bool> ac3-dts: false;
    in-out property <bool> processing: false;
    in-out property <bool> reset-sync-exit: false;

    property <[string]> languages: [
        Translation.tr("自动", Translation.language-gen),
        Translation.tr("中文", Translation.language-gen),
        "English",
        Translation.tr("日本語", Translation.language-gen),
        Translation.tr("한국어", Translation.language-gen),
    ];
    property <bool> open-dd: false;

    callback apply;
    callback close;

    width: 540px;
    height: 330px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    DialogHeader {
        x: 0;
        y: 0;
        width: parent.width;
