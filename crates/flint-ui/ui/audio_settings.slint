    DlgCheck {
        x: 20px;
        y: 142px;
        width: 460px;
        label: Translation.tr("AC3/DTS 直通到 S/PDIF/HDMI", Translation.language-gen);
        checked: root.ac3-dts;
        toggled => { root.ac3-dts = !root.ac3-dts; }
    }

    Text {
        x: 20px;
        y: 178px;
        width: 100px;
        height: 22px;
        text: Translation.tr("其他", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    DlgCheck {
        x: 20px;
        y: 208px;
        width: 460px;
        label: Translation.tr("开启声音处理", Translation.language-gen);
        checked: root.processing;
        toggled => { root.processing = !root.processing; }
    }

    DlgCheck {
        x: 20px;
        y: 236px;
        width: 460px;
        label: Translation.tr("退出时初始化声音同步", Translation.language-gen);
        checked: root.reset-sync-exit;
        toggled => { root.reset-sync-exit = !root.reset-sync-exit; }
    }

    DlgButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }

    if (root.open-dd) : Rectangle {
        x: 120px;
        y: 66px;
        width: 220px;
        height: root.languages.length * 20px + 2px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        for option[index] in root.languages : Rectangle {
            y: index * 20px;
            height: 20px;
            width: parent.width;
            background: option-touch.has-hover ? #3a8fd9 : transparent;

            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: option;
                color: option-touch.has-hover ? #ffffff : #1a1a1a;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            option-touch := TouchArea {
                clicked => {
                    root.language-index = index;
                    root.open-dd = false;
                }
            }
        }
    }
}
