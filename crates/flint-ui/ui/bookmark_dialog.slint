import { ScrollView } from "std-widgets.slint";
import { Translation } from "translation.slint";

export struct BookmarkRow {
    label: string,
}

component DlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 23px;
    background: !root.enabled
        ? #ececec
        : root.primary
            ? (ta.has-hover ? #d8ecff : #e7f3ff)
            : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component BookmarkDialog inherits Rectangle {
    in property <bool> active: false;
    in property <[BookmarkRow]> rows: [];
    in-out property <int> selected: -1;
    callback picked(int);
    callback add;
    callback remove;
    callback clear;
    callback close;

    width: 420px;
    height: 430px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: Translation.tr("书签", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            x: parent.width - 40px;
            width: 40px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    TouchArea {
        y: 28px;
        height: parent.height - 28px;
        clicked => { }
    }

    Rectangle {
        x: 8px;
        y: 36px;
        width: parent.width - 16px;
        height: parent.height - 36px - 40px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;
        clip: true;

        ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;

            VerticalLayout {
                for row[index] in root.rows : Rectangle {
                    height: 24px;

                    background: index == root.selected ? #cfe4f7 : (row-touch.has-hover ? #e8f2fb : transparent);

                    Text {
                        x: 8px;
                        y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: row.label;
                        color: #1a1a1a;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.selected = index;
                            root.picked(index);
                        }
                    }
                }

                Rectangle {
                    height: root.rows.length == 0 ? 24px : 0px;

                    Text {
                        x: 8px;
                        y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: Translation.tr("暂无书签", Translation.language-gen);
                        color: #7a7a7a;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    DlgButton {
        x: 8px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("添加", Translation.language-gen);
        clicked => { root.add(); }
    }

    DlgButton {
        x: 90px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("删除", Translation.language-gen);
        enabled: root.selected >= 0;
        clicked => { root.remove(); }
    }

    DlgButton {
        x: 172px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("清除", Translation.language-gen);
        clicked => { root.clear(); }
    }

    DlgButton {
        x: parent.width - 84px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("关闭", Translation.language-gen);
        primary: true;
        clicked => { root.close(); }
    }
}
