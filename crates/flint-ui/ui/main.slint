import { ControlBar } from "control_bar.slint";
import { Sidebar, BrowserItem } from "sidebar.slint";
import { DeviceMenu, DeviceEntry, ResolutionEntry } from "device_menu.slint";
import { CapturePanel, PanelInfo } from "capture_panel.slint";
import { DeviceSettings } from "device_settings.slint";
import { FileDialog, FileEntry } from "file_dialog.slint";
import { AboutDialog } from "about_dialog.slint";
import { NetworkDialog } from "network_dialog.slint";
import { BookmarkDialog, BookmarkRow } from "bookmark_dialog.slint";
import { MenuSearchDialog, SearchRow } from "menu_search.slint";
import { NavigationSettingsDialog } from "navigation_settings.slint";
import { CaptureSizeDialog } from "capture_size.slint";
import { SkinRow, SkinSettings, SubtitleSettings, SubtitleInput } from "subtitle_settings.slint";
import { ShutdownPrompt } from "shutdown_dialog.slint";
import { ConfigManager } from "config_manager.slint";
