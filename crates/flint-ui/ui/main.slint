                    { title: Translation.tr("窗口 +", Translation.language-gen), shortcut: Translation.tr("Ctrl+Alt+数字键+", Translation.language-gen), enabled: true, checkable: false, checked: false, arrow: false, command: "window-grow", children: [] },
                    { title: Translation.tr("窗口 -", Translation.language-gen), shortcut: Translation.tr("Ctrl+Alt+数字键-", Translation.language-gen), enabled: true, checkable: false, checked: false, arrow: false, command: "window-shrink", children: [] },
                    { title: Translation.tr("窗口定位", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: true, command: "", children: [
