export { DeviceEntry, ResolutionEntry, PanelInfo, OsdToken, FileEntry, BrowserItem }
export { Translation } from "translation.slint";
export { UiOptions } from "options.slint";

export struct MenuSub {
    title: string,
    shortcut: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    arrow: bool,
    command: string,
}

export struct MenuLeaf {
    title: string,
    shortcut: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    arrow: bool,
    command: string,
    children: [MenuSub],
}

export struct MenuEntry {
    title: string,
    shortcut: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    separator: bool,
    command: string,
    children: [MenuLeaf],
}

component MenuLeafRow inherits Rectangle {
    in property <MenuLeaf> leaf;
    in property <float> menu-alpha: 1;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);
    callback scrolled(float);
    callback hovered(length, [MenuSub]);

    height: leaf.title == "" ? 9px * root.menu-scale : 26px * root.menu-scale;
    background: ta.has-hover && leaf.enabled ? root.menu-hover.with-alpha(root.menu-alpha) : transparent;

    property <bool> lit: ta.has-hover;
    property <bool> header: leaf.title != "" && leaf.command == "" && !leaf.checkable && !leaf.arrow;

    Rectangle {
        x: 6px * root.menu-scale;
        y: (parent.height - 8px * root.menu-scale) / 2;
        width: 8px * root.menu-scale;
        height: 8px * root.menu-scale;
        border-radius: 4px * root.menu-scale;
        background: root.menu-check;
        visible: leaf.checked && leaf.arrow;
    }

    Text {
        x: 6px * root.menu-scale;
        y: 0;
        width: 12px * root.menu-scale;
        height: parent.height;
        text: "✓";
        color: root.menu-check;
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        visible: leaf.checkable && leaf.checked;
    }

    Text {
        x: 26px * root.menu-scale;
        y: 0;
        width: parent.width - 26px * root.menu-scale - (leaf.shortcut != "" ? 76px * root.menu-scale : 10px * root.menu-scale) - (leaf.arrow ? 18px * root.menu-scale : 0px);
        height: parent.height;
        text: leaf.title;
        color: !leaf.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-text);
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        overflow: elide;
        visible: !root.header || UiOptions.menu-show-names;
    }

    Text {
        x: parent.width - 76px * root.menu-scale - (leaf.arrow ? 18px * root.menu-scale : 0px);
        y: 0;
        width: 66px * root.menu-scale;
        height: parent.height;
        text: leaf.shortcut;
        color: !leaf.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-shortcut-color);
        font-size: 11px * root.menu-scale;
        horizontal-alignment: right;
        vertical-alignment: center;
        visible: leaf.shortcut != "";
    }

    Text {
        x: parent.width - 20px * root.menu-scale;
        y: 0;
        width: 12px * root.menu-scale;
        height: parent.height;
        text: "›";
        color: root.lit ? root.menu-lit : root.menu-dim;
        font-size: 13px * root.menu-scale;
        vertical-alignment: center;
        visible: leaf.arrow;
    }

    ta := TouchArea {
        enabled: leaf.enabled;
        clicked => { if (leaf.command != "") { root.chosen(leaf.command); } }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered(ta.absolute-position.y, leaf.children);
            }
        }
        scroll-event(event) => { root.scrolled(event.delta-y / 1px); accept }
    }
}

component MenuSubRow inherits Rectangle {
    in property <MenuSub> leaf;
    in property <float> menu-alpha: 1;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);
    callback scrolled(float);

    height: leaf.title == "" ? 9px * root.menu-scale : 26px * root.menu-scale;
    background: ta.has-hover && leaf.enabled ? root.menu-hover.with-alpha(root.menu-alpha) : transparent;

    property <bool> lit: ta.has-hover;
    property <bool> header: leaf.title != "" && leaf.command == "" && !leaf.checkable && !leaf.arrow;

    Text {
        x: 6px * root.menu-scale;
        y: 0;
        width: 12px * root.menu-scale;
        height: parent.height;
        text: "✓";
        color: root.menu-check;
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        visible: leaf.checkable && leaf.checked;
    }

    Text {
        x: 26px * root.menu-scale;
        y: 0;
        width: parent.width - 26px * root.menu-scale - (leaf.shortcut != "" ? 76px * root.menu-scale : 10px * root.menu-scale);
        height: parent.height;
        text: leaf.title;
        color: !leaf.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-text);
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        overflow: elide;
        visible: !root.header || UiOptions.menu-show-names;
    }

    Text {
        x: parent.width - 76px * root.menu-scale;
        y: 0;
        width: 66px * root.menu-scale;
        height: parent.height;
        text: leaf.shortcut;
        color: !leaf.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-shortcut-color);
        font-size: 11px * root.menu-scale;
        horizontal-alignment: right;
        vertical-alignment: center;
        visible: leaf.shortcut != "";
    }

    ta := TouchArea {
        enabled: leaf.enabled;
        clicked => { if (leaf.command != "") { root.chosen(leaf.command); } }
        scroll-event(event) => { root.scrolled(event.delta-y / 1px); accept }
    }
}

component MenuLeafList inherits Rectangle {
    in property <[MenuLeaf]> leaves;
    in property <length> limit-height: 100000px;
    in property <length> content-length: 0px;
    in property <float> menu-alpha: 1;
    in property <color> menu-bg: #444444;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);

    in property <length> container-width: 100000px;
    in property <length> container-height: 100000px;
    property <[MenuSub]> sub-leaves: [];
    property <length> sub-row-abs: 0px;
    property <length> sub-scroll: 0px;
    property <length> sub-measured: root.sub-leaves.length * 26px * root.menu-scale + 8px * root.menu-scale;
    property <length> sub-height: Math.min(sub-measured, container-height - 8px);
    property <length> sub-abs-y: root.sub-row-abs + sub-height > container-height - 4px
        ? Math.max(4px, container-height - 4px - sub-height)
        : root.sub-row-abs - 4px;
    property <length> sub-y: root.sub-abs-y - root.y;
    property <length> sub-x: root.x + root.width + 212px * root.menu-scale > container-width ? root.x - 212px * root.menu-scale : root.x + root.width;

    property <length> measured-height: list.preferred-height + 8px * root.menu-scale;
    property <length> content-height: content-length > measured-height ? content-length : measured-height;
    property <length> scroll-offset: 0px;
    property <length> max-offset: content-height > self.height ? content-height - self.height : 0px;

    width: 212px * root.menu-scale;
    height: content-height < limit-height ? content-height : limit-height;
    clip: true;
    background: root.menu-bg.with-alpha(root.menu-alpha);
    border-width: 1px;
    border-color: #2a2a2a;
    border-radius: 3px;

    list := VerticalLayout {
        x: 1px;
        y: 4px * root.menu-scale - root.scroll-offset;
        width: parent.width - 2px;
        for leaf in leaves : MenuLeafRow {
            leaf: leaf;
            menu-alpha: root.menu-alpha;
            menu-hover: root.menu-hover;
            menu-scale: root.menu-scale;
            menu-text: root.menu-text;
            menu-dim: root.menu-dim;
            menu-lit: root.menu-lit;
            menu-shortcut-color: root.menu-shortcut-color;
            menu-check: root.menu-check;
            chosen(cmd) => { root.chosen(cmd); }
            hovered(y, children) => {
                root.sub-leaves = children;
                root.sub-row-abs = y;
            }
            scrolled(delta) => {
                root.scroll-offset = Math.max(0px, Math.min(root.max-offset, root.scroll-offset - delta * 1px));
            }
        }
    }

    changed leaves => { root.scroll-offset = 0px; root.sub-leaves = []; }
    changed sub-leaves => { root.sub-scroll = 0px; }

    Rectangle {
        visible: root.max-offset > 0px && root.scroll-offset > 0px;
        x: parent.width - 22px;
        y: 5px;
        width: 16px;
        height: 14px;
        background: #5a5a5a;
        border-radius: 2px;

        Text {
            text: "▲";
            color: #e6e6e6;
            font-size: 9px;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.scroll-offset = root.scroll-offset > 130px ? root.scroll-offset - 130px : 0px;
            }
        }
    }

    Rectangle {
        visible: root.max-offset > 0px && root.scroll-offset < root.max-offset;
        x: parent.width - 22px;
        y: parent.height - 19px;
        width: 16px;
        height: 14px;
        background: #5a5a5a;
        border-radius: 2px;

        Text {
            text: "▼";
            color: #e6e6e6;
            font-size: 9px;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.scroll-offset = root.scroll-offset + 130px < root.max-offset ? root.scroll-offset + 130px : root.max-offset;
            }
        }
    }

    out property <[MenuSub]> sub-leaves-out: root.sub-leaves;
    out property <length> sub-x-out: root.sub-x;
    out property <length> sub-y-out: root.sub-y;
    out property <length> sub-height-out: root.sub-height;
}

component MenuSubList inherits Rectangle {
    in property <[MenuSub]> rows;
    in property <float> menu-alpha: 1;
    in property <color> menu-bg: #444444;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);

    property <length> measured-height: list.preferred-height + 8px * root.menu-scale;
    property <length> scroll-offset: 0px;
    property <length> max-offset: measured-height > self.height ? measured-height - self.height : 0px;

    width: 212px * root.menu-scale;
    height: measured-height;
    clip: true;
    background: root.menu-bg.with-alpha(root.menu-alpha);
    border-width: 1px;
    border-color: #2a2a2a;
    border-radius: 3px;

    list := VerticalLayout {
        x: 1px;
        y: 4px * root.menu-scale - root.scroll-offset;
        width: parent.width - 2px;
        for leaf in rows : MenuSubRow {
            leaf: leaf;
            menu-alpha: root.menu-alpha;
            menu-hover: root.menu-hover;
            menu-scale: root.menu-scale;
            menu-text: root.menu-text;
            menu-dim: root.menu-dim;
            menu-lit: root.menu-lit;
            menu-shortcut-color: root.menu-shortcut-color;
            menu-check: root.menu-check;
            chosen(cmd) => { root.chosen(cmd); }
            scrolled(delta) => {
                root.scroll-offset = Math.max(0px, Math.min(root.max-offset, root.scroll-offset - delta * 1px));
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <int> index: 0;
    in property <float> menu-alpha: 1;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);
    callback hovered(length, [MenuLeaf]);
    callback scrolled(float);

    height: entry.separator ? 9px * root.menu-scale : 26px * root.menu-scale;
    background: entry.separator ? transparent : (ta.has-hover && entry.enabled ? root.menu-hover.with-alpha(root.menu-alpha) : transparent);

    property <bool> lit: ta.has-hover;

    Text {
        x: 6px * root.menu-scale;
        y: 0;
        width: 12px * root.menu-scale;
        height: parent.height;
        text: "✓";
        color: root.menu-check;
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        visible: !entry.separator && entry.checkable && entry.checked;
    }

    Text {
        x: entry.checkable ? 22px * root.menu-scale : 12px * root.menu-scale;
        y: 0;
        width: parent.width - (entry.checkable ? 22px * root.menu-scale : 12px * root.menu-scale) - (entry.shortcut != "" ? 74px * root.menu-scale : 12px * root.menu-scale) - (entry.children.length > 0 ? 18px * root.menu-scale : 0px);
        height: parent.height;
        text: entry.title;
        color: !entry.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-text);
        font-size: 12px * root.menu-scale;
        vertical-alignment: center;
        overflow: elide;
        visible: !entry.separator;
    }

    Text {
        x: parent.width - 76px * root.menu-scale - (entry.children.length > 0 ? 18px * root.menu-scale : 0px);
        y: 0;
        width: 66px * root.menu-scale;
        height: parent.height;
        text: entry.shortcut;
        color: !entry.enabled ? root.menu-dim : (root.lit ? root.menu-lit : root.menu-shortcut-color);
        font-size: 11px * root.menu-scale;
        horizontal-alignment: right;
        vertical-alignment: center;
        visible: !entry.separator && entry.shortcut != "";
    }

    Text {
        x: parent.width - 20px * root.menu-scale;
        y: 0;
        width: 12px * root.menu-scale;
        height: parent.height;
        text: "›";
        color: root.lit ? root.menu-lit : root.menu-dim;
        font-size: 13px * root.menu-scale;
        vertical-alignment: center;
        visible: !entry.separator && entry.children.length > 0;
    }

    ta := TouchArea {
        enabled: entry.enabled;
        clicked => {
            if (entry.children.length > 0) {
                root.hovered(ta.absolute-position.y, entry.children);
            } else if (!entry.separator && entry.command != "") {
                root.chosen(entry.command);
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered(ta.absolute-position.y, entry.children);
            }
        }
        scroll-event(event) => { root.scrolled(event.delta-y / 1px); accept }
    }
}

component MenuPopup inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <length> container-width: 100000px;
    in property <length> container-height: 100000px;
    in property <float> menu-alpha: 1;
    in property <color> menu-bg: #444444;
    in property <color> menu-hover: #1c1c1c;
    in property <float> menu-scale: 1;
    in property <color> menu-text: #e6e6e6;
    in property <color> menu-dim: #8a8a8a;
    in property <color> menu-lit: #fae100;
    in property <color> menu-shortcut-color: #bdbdbd;
    in property <color> menu-check: #fae100;
    callback chosen(string);
    in-out property <int> open-index: -1;
    in property <length> limit-height: 100000px;

    property <length> content-height: layout.preferred-height + 8px * root.menu-scale;
    property <length> scroll-offset: 0px;
    property <length> max-offset: content-height > self.height ? content-height - self.height : 0px;
    property <[MenuLeaf]> submenu-leaves: [];
    property <length> submenu-row-abs: 0px;

    property <length> submenu-content-height: submenu-leaves.length * 26px * root.menu-scale + 8px * root.menu-scale;
    property <length> submenu-limit: Math.min(container-height - 8px, 560px);
    property <length> submenu-height: submenu-content-height < submenu-limit ? submenu-content-height : submenu-limit;
    property <length> submenu-abs-y: root.submenu-row-abs + root.submenu-height > container-height - 4px
        ? Math.max(4px, container-height - 4px - submenu-height)
        : root.submenu-row-abs - 4px;
    property <length> submenu-y: submenu-abs-y - self.y;

    out property <[MenuLeaf]> submenu-leaves-out: root.open-index >= 0 ? root.submenu-leaves : [];
    out property <length> submenu-left-out: root.x + 181px * root.menu-scale + 212px * root.menu-scale > root.container-width ? -212px * root.menu-scale : 181px * root.menu-scale;
    out property <length> submenu-top-out: root.submenu-y;
    out property <length> submenu-height-out: root.submenu-height;
    out property <length> submenu-content-out: root.submenu-content-height;

    width: 182px * root.menu-scale;
    height: content-height < limit-height ? content-height : limit-height;
    background: root.menu-bg.with-alpha(root.menu-alpha);
    border-width: 1px;
    border-color: #2a2a2a;
    border-radius: 3px;

    viewport := Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        background: transparent;

        layout := VerticalLayout {
            x: 1px;
            y: 4px * root.menu-scale - root.scroll-offset;
            width: parent.width - 2px;
            for entry[i] in entries : MenuRow {
                entry: entry;
                index: i;
                menu-alpha: root.menu-alpha;
                menu-hover: root.menu-hover;
                menu-scale: root.menu-scale;
                menu-text: root.menu-text;
                menu-dim: root.menu-dim;
                menu-lit: root.menu-lit;
                menu-shortcut-color: root.menu-shortcut-color;
                menu-check: root.menu-check;
                hovered(y, children) => {
                    root.open-index = i;
                    root.submenu-leaves = children;
                    root.submenu-row-abs = y;
                }
                chosen(cmd) => { root.chosen(cmd); }
                scrolled(delta) => {
                    root.scroll-offset = Math.max(0px, Math.min(root.max-offset, root.scroll-offset - delta * 1px));
                }
            }
        }
    }

}

export component MainWindow inherits Window {
    title: "FlintPlayer";
    no-frame: true;
    resize-border-width: 6px;
    background: Palette.bg;
    min-width: 720px;
    min-height: 480px;
    always-on-top: root.pinned;

    in property <bool> pinned: false;
    in property <bool> split-view: false;
    in property <[PanelInfo]> panels: [];
    in property <int> active-index: 0;
    in property <bool> running: false;
    in property <bool> recording: false;
    in property <bool> frozen: false;
    in property <bool> fullscreen: false;
    in property <bool> osd-visible: false;
    in property <bool> osd-brief: false;
    in property <bool> osd-playback: false;
    in property <string> osd-brief-text: "";
    in property <string> osd-playback-text: "";
    in property <bool> chrome-visible: true;
    in property <bool> menu-open: false;
    in property <bool> repeat: false;
    in property <bool> shuffle: false;
    in-out property <bool> stretch: false;
    in-out property <int> zoom-ratio: 0;
    in-out property <bool> zoom-crop: false;
    in-out property <int> zoom-shift-x: 0;
    in-out property <int> zoom-shift-y: 0;
    in-out property <int> frame-scale-x: 100;
    in-out property <int> frame-scale-y: 100;
    in-out property <bool> remember-frame: false;
    in-out property <string> volume-control: "default";
    in-out property <bool> audio-record-play-folder: false;
    in-out property <bool> video-record-play-folder: false;
    in-out property <int> margin-bottom: 0;
    in-out property <bool> margin-auto: false;
    in-out property <bool> margin-force: false;
    in-out property <string> snapshot-format: "png";
    in-out property <string> snapshot-name: "time";
    in-out property <bool> snapshot-play-folder: false;
    in-out property <string> post-action: "none";
    in-out property <string> topmost-mode: "never";
    in-out property <bool> autohide-controls: true;
    in-out property <bool> fullscreen-no-cover: false;
    in-out property <bool> ignore-shortcuts: false;
    in-out property <bool> favorites-memory-points: false;
    in-out property <string> similar-mode: "selected";
    in-out property <string> video-renderer: "auto";
    in-out property <bool> touch-enabled: true;
    in-out property <bool> move-only-titlebar: true;
    in-out property <float> skin-opacity: 1;
    in-out property <color> skin-accent: #4aa3ff;
    in-out property <color> skin-menu-bg: #444444;
    in-out property <color> skin-menu-hover: #1c1c1c;
    in-out property <string> popup-menu-type: "skin";
    in-out property <string> menu-output-mode: "auto";
    property <bool> system-popup-menu: root.popup-menu-type == "system";
    property <bool> light-popup-menu: root.system-popup-menu && root.menu-output-mode != "dark";
    property <color> menu-text-color: root.light-popup-menu ? #1a1a1a : #e6e6e6;
    property <color> menu-dim-color: root.light-popup-menu ? #9a9a9a : #8a8a8a;
    property <color> menu-lit-color: root.light-popup-menu ? #1a5fa8 : #fae100;
