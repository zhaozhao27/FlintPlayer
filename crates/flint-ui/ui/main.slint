        FileDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            dir: root.file-dir;
            entries: root.file-entries;
            folder-mode: root.file-folder-mode;
            selected <=> root.file-selected;
            path-input <=> root.file-path-input;
            navigate(path) => { root.file-navigate(path); }
            picked(index) => { root.file-picked(index); }
            open-selected => { root.file-open-selected(); }
            choose-dir(path) => { root.file-choose-dir(path); }
            close => { root.file-open = false; root.file-dialog-closed(); keys.focus(); }
        }
    }

