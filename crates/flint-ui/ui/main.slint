        subpop := MenuLeafList {
            x: popup.x + popup.submenu-left-out;
            y: popup.y + popup.submenu-top-out;
            limit-height: popup.submenu-height-out;
            content-length: popup.submenu-content-out;
            leaves: popup.submenu-leaves-out;
            container-width: root.width;
            container-height: root.height;
            menu-alpha: root.skin-opacity;
            menu-bg: root.effective-menu-bg;
            menu-hover: root.effective-menu-hover;
            menu-scale: root.menu-scale;
            menu-text: root.menu-text-color;
            menu-dim: root.menu-dim-color;
            menu-lit: root.menu-lit-color;
            menu-shortcut-color: root.menu-shortcut-color;
            menu-check: root.menu-check-color;
            visible: popup.submenu-leaves-out.length > 0;
            chosen(cmd) => {
                root.popup-open = false;
                root.menu-command(cmd);
                keys.focus();
            }
        }

        MenuSubList {
            x: subpop.sub-x-out;
            y: subpop.y + subpop.sub-y-out;
            rows: subpop.sub-leaves-out;
            menu-alpha: root.skin-opacity;
            menu-bg: root.effective-menu-bg;
            menu-hover: root.effective-menu-hover;
            menu-scale: root.menu-scale;
            menu-text: root.menu-text-color;
            menu-dim: root.menu-dim-color;
            menu-lit: root.menu-lit-color;
            menu-shortcut-color: root.menu-shortcut-color;
            menu-check: root.menu-check-color;
            visible: subpop.sub-leaves-out.length > 0;
            chosen(cmd) => {
                root.popup-open = false;
                root.menu-command(cmd);
                keys.focus();
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000066;
        visible: root.settings-open;

        TouchArea {
            clicked => { root.settings-open = false; }
        }

        DeviceSettings {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            tab <=> root.settings-tab;
            device-names: root.device-names;
            device-index <=> root.selected-device;
            format-names: root.settings-format-names;
            format-index <=> root.settings-format-index;
            device-picked(index) => {
                root.selected-device = index;
                root.settings-device-picked(index);
            }
            format-picked(index) => { root.settings-format-picked(index); }
            close => { root.settings-open = false; keys.focus(); }
            capture-slot(slot) => {
                root.settings-open = false;
                root.menu-command(slot == 2 ? "capture-slot2" : "capture-slot1");
                keys.focus();
            }
            capture-size(slot) => {
                root.settings-open = false;
                root.menu-command(slot == 2 ? "capture-size2" : "capture-size1");
                keys.focus();
            }
            open-device => {
                root.settings-open = false;
                root.settings-device-open(root.selected-device);
                keys.focus();
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000040;
        visible: root.file-open;

        TouchArea {
            clicked => { root.file-open = false; root.file-dialog-closed(); }
