        ThumbnailDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width-text <=> root.thumbnail-width;
            directory: root.thumbnail-directory;
            status: root.thumbnail-status;
            create-thumbnail(width) => { root.thumbnail-create(width); }
            close => {
                root.thumbnail-open = false;
                keys.focus();
            }
        }
    }
}
