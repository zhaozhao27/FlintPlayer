                    { title: Translation.tr("全屏+(拉伸)", Translation.language-gen), shortcut: "Ctrl+Enter", enabled: true, checkable: false, checked: false, arrow: false, command: "fullscreen", children: [] },
                    { title: Translation.tr("全屏+(保持比例)", Translation.language-gen), shortcut: "Ctrl+Alt+Enter", enabled: true, checkable: false, checked: false, arrow: false, command: "fullscreen", children: [] },
                    { title: Translation.tr("全屏(其他显示器)", Translation.language-gen), shortcut: "Ctrl+Shift+Enter", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
