    callback toggle-always-on-top;
    callback menu-command(string);
    callback volume-settings-apply;
    callback audio-settings-apply;
    callback audio-sync-settings-apply;
    callback audio-general-settings-apply;
    callback skin-opacity-changed(float);
    callback skin-settings-confirm;
    callback skin-settings-cancel;
    callback skin-pick(int);
    callback skin-browse;
    callback file-dialog-closed;
    callback seek-requested(float);
    callback seek-preview(float);
    callback volume-changed(float);
    callback file-navigate(string);
    callback file-picked(int);
    callback file-open-selected;
    callback file-choose-dir(string);
    callback minimize-window;
    callback maximize-window;
    callback close-window;
    callback panel-picked(int);
    callback panel-prev;
    callback panel-next;
    callback panel-toggle-fullscreen(int);
    callback panel-closed(int);
    callback browser-navigate(string);
    callback browser-open(string);
    callback browser-up;
    callback activity;
    callback pano-drag(length, length);
    callback pano-zoom(float);
    callback panel-touch-seek(int, float);
    callback window-drag(length, length);
    callback shutdown-confirmed;
    callback shutdown-cancelled;
    callback config-picked(int);
    callback config-load;
    callback config-create;
    callback config-rename(string);
    callback config-delete;
    callback burst-start(string, string);
    callback path-dialog-apply(string);
    callback thumbnail-create(string);

    forward-focus: keys;

    changed about-open => {
        if (root.about-open) { keys.focus(); }
    }

    changed shutdown-prompt-open => {
        if (root.shutdown-prompt-open) { keys.focus(); }
    }

    changed file-open => {
        if (!root.file-open) { keys.focus(); }
    }

        keys := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        capture-key-pressed(event) => {
            if (root.settings-open && event.text == "\u{F702}") {
                if (root.settings-tab > 0) { root.settings-tab -= 1; } accept
            } else if (root.settings-open && event.text == "\u{F703}") {
                if (root.settings-tab < 4) { root.settings-tab += 1; } accept
            } else if (root.settings-open && !event.repeat && event.modifiers.control && event.text == "\u{9}") {
                root.settings-tab = Math.mod(root.settings-tab + (event.modifiers.shift ? 4 : 1), 5); accept
            } else if (root.settings-open && event.text == "\u{9}") {
                root.settings-tab = Math.mod(root.settings-tab + (event.modifiers.shift ? 4 : 1), 5); accept
            } else if (root.file-open && event.text == "\n") {
                root.file-open-selected(); accept
            } else if (root.file-open && event.text == "\u{1b}") {
                root.file-open = false;
                root.file-dialog-closed();
                accept
            } else if (root.config-manager-open && event.text == "\u{1b}") {
                root.config-manager-open = false;
                keys.focus();
                accept
            } else if (root.config-manager-open) {
                reject
            } else if (root.burst-open && event.text == "\u{1b}") {
                root.burst-open = false;
                keys.focus();
                accept
            } else if (root.burst-open) {
                reject
            } else if (root.path-dialog-open && event.text == "\u{1b}") {
                root.path-dialog-open = false;
                keys.focus();
                accept
            } else if (root.path-dialog-open) {
                reject
            } else if (root.thumbnail-open && event.text == "\u{1b}") {
                root.thumbnail-open = false;
                keys.focus();
                accept
            } else if (root.thumbnail-open) {
                reject
            } else if (root.shutdown-prompt-open) {
                if (event.text == "\u{1b}") {
                    root.shutdown-prompt-open = false;
                    accept
                } else {
                    reject
                }
            } else if (root.volume-settings-open && event.text == "\u{1b}") {
                root.volume-settings-open = false;
                keys.focus();
                accept
            } else if (root.volume-settings-open) {
                reject
            } else if (root.audio-settings-open && event.text == "\u{1b}") {
                root.audio-settings-open = false;
                keys.focus();
                accept
            } else if (root.audio-settings-open) {
                reject
            } else if (root.audio-sync-settings-open && event.text == "\u{1b}") {
                root.audio-sync-settings-open = false;
                keys.focus();
                accept
            } else if (root.audio-sync-settings-open) {
                reject
            } else if (root.audio-general-settings-open && event.text == "\u{1b}") {
                root.audio-general-settings-open = false;
                keys.focus();
                accept
            } else if (root.audio-general-settings-open) {
                reject
            } else if (root.open-url-open && event.text == "\u{1b}") {
                root.open-url-open = false;
                keys.focus();
                accept
            } else if (root.open-url-open) {
                reject
            } else if (root.bookmarks-open && event.text == "\u{1b}") {
                root.bookmarks-open = false;
                keys.focus();
                accept
            } else if (root.bookmarks-open) {
                reject
            } else if (root.menu-search-open && event.text == "\u{1b}") {
                root.menu-search-open = false;
                keys.focus();
                accept
            } else if (root.menu-search-open) {
                reject
            } else if (root.navigation-settings-open && event.text == "\u{1b}") {
                root.navigation-settings-open = false;
                keys.focus();
                accept
            } else if (root.navigation-settings-open) {
                reject
            } else if (root.capture-size-open && event.text == "\u{1b}") {
                root.capture-size-open = false;
                keys.focus();
                accept
            } else if (root.capture-size-open) {
                reject
            } else if (root.window-size-open && event.text == "\u{1b}") {
                root.window-size-open = false;
                keys.focus();
                accept
            } else if (root.window-size-open) {
                reject
            } else if (root.about-open && event.text == "\u{1b}") {
                root.about-open = false; accept
            } else if (root.subtitle-settings-open && event.text == "\u{1b}") {
                root.subtitle-settings-open = false; accept
            } else if (root.subtitle-settings-open) {
                reject
            } else if (root.skin-settings-open && event.text == "\u{1b}") {
                root.skin-settings-open = false;
                root.skin-settings-cancel();
                keys.focus(); accept
            } else if (root.skin-settings-open) {
                reject
            } else if (root.manual-open) {
                if (event.text == "\u{1b}") {
                    root.manual-open = false;
                    root.manual-text = "";
                    accept
                } else {
                    reject
                }
            } else if (root.ignore-shortcuts && event.text != "\u{1b}") {
                reject
            } else if (!event.repeat && event.modifiers.shift && event.text == "\u{9}") {
                if (root.key-command("shift+tab")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && (event.text == "\u{ff14}" || event.text == "\u{F72F}")) {
                if (root.key-command("scrolllock")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && event.text == "\n") {
                if (root.key-command("alt+enter")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "o" || event.text == "O")) {
                if (root.key-command("ctrl+o")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "u" || event.text == "U" || event.text == "\u{15}")) {
                if (root.key-command("ctrl+u")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "v" || event.text == "V" || event.text == "\u{16}")) {
                if (root.key-command("ctrl+v")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "g" || event.text == "G" || event.text == "\u{7}")) {
                if (root.key-command("ctrl+g")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "y" || event.text == "Y" || event.text == "\u{19}")) {
                if (root.key-command("ctrl+y")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "t" || event.text == "T" || event.text == "\u{14}")) {
                if (root.key-command("ctrl+t")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "d" || event.text == "D")) {
                if (root.key-command("alt+d")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "o" || event.text == "O")) {
                if (root.key-command("alt+o")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "p" || event.text == "P")) {
                if (root.key-command("alt+p")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "n" || event.text == "N")) {
                if (root.key-command("alt+n")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "e" || event.text == "E")) {
                if (root.key-command("alt+e")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "h" || event.text == "H")) {
                if (root.key-command("alt+h")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "k" || event.text == "K")) {
                if (root.key-command("alt+k")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                if (root.key-command("alt+v")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.alt && event.text == "\u{F727}") {
                if (root.key-command("alt+insert")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && event.text == "\u{F727}") {
                if (root.key-command("ctrl+insert")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "w" || event.text == "W" || event.text == "\u{17}")) {
                if (root.key-command("ctrl+w")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "p" || event.text == "P" || event.text == "\u{10}")) {
                if (root.key-command("ctrl+p")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "z" || event.text == "Z" || event.text == "\u{1a}")) {
                if (root.key-command("ctrl+z")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && event.modifiers.alt && (event.text == "b" || event.text == "B")) {
                if (root.key-command("ctrl+alt+b")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && event.modifiers.alt && (event.text == "a" || event.text == "A")) {
                if (root.key-command("ctrl+alt+a")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "\u{F708}" || event.text == "\u{f708}")) {
                if (root.key-command("ctrl+f5")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && (event.text == "\u{F70F}" || event.text == "\u{f70f}")) {
                if (root.menu-search-open) {
                    root.menu-search-open = false;
                    keys.focus();
                    accept
                } else {
                    if (root.key-command("ctrl+f12")) { keys.focus(); accept } else { reject }
                }
            } else if (!event.repeat && event.modifiers.control && (event.text == "\u{F709}" || event.text == "\u{f709}")) {
                if (root.key-command("ctrl+f6")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "6" || event.text == "\u{1e}")) {
                if (root.key-command("ctrl+6")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "4" || event.text == "\u{1c}")) {
                if (root.key-command("ctrl+4")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "8" || event.text == "\u{8}" || event.text == "\u{7f}")) {
                if (root.key-command("ctrl+8")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "2" || event.text == "\u{0}")) {
                if (root.key-command("ctrl+2")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "5" || event.text == "\u{1d}")) {
                if (root.key-command("ctrl+5")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "g" || event.text == "G")) {
                if (root.key-command("shift+g")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "e" || event.text == "E")) {
                if (root.key-command("shift+e")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "x" || event.text == "X")) {
                if (root.key-command("shift+x")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "n" || event.text == "N")) {
                if (root.key-command("shift+n")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                if (root.key-command("shift+c")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "d" || event.text == "D")) {
                if (root.key-command("shift+d")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "r" || event.text == "R")) {
                if (root.key-command("shift+r")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "v" || event.text == "V")) {
                if (root.key-command("shift+v")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                if (root.key-command("shift+a")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "," || event.text == "<")) {
                if (root.key-command("shift+,")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "." || event.text == ">")) {
                if (root.key-command("shift+.")) { keys.focus(); accept } else { reject }
            } else if (!event.repeat && event.modifiers.shift && (event.text == "/" || event.text == "?")) {
                if (root.key-command("shift+/")) { keys.focus(); accept } else { reject }
            } else if (event.text == "\u{1b}") {
                if (root.settings-open) { root.settings-open = false; accept }
                else if (root.popup-open) { root.popup-open = false; accept }
                else if (root.key-command(event.text)) { keys.focus(); accept } else { reject }
            } else if (event.repeat && (event.text == "\u{f700}" || event.text == "\u{f701}" || event.text == "\u{f702}" || event.text == "\u{f703}")) {
                if (root.key-command(event.text)) { accept } else { reject }
            } else if (event.repeat) {
                reject
            } else if (event.modifiers.alt || event.modifiers.control || event.modifiers.meta) {
                reject
            } else if (root.menu-open && menu.url-focus) {
                reject
            } else if (root.key-command(event.text)) {
                accept
            } else {
                reject
            }
        }

        titlebar := Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.fullscreen || root.video-skin ? 0px : 40px;
            background: #1e1e1e;
            visible: !root.fullscreen && !root.video-skin;

            WindowMoveArea {
                x: 0;
                y: 0;
                width: parent.width - 134px;
                height: parent.height;
            }

            menu-opener := TouchArea {
                x: 0;
                y: 0;
                width: 94px;
                height: parent.height;

                clicked => {
                    root.popup-x = 0px;
                    root.popup-y = 40px;
                    root.popup-open = true;
                    keys.focus();
                }
            }

            Text {
                x: 12px;
                y: 0;
                width: 66px;
                height: parent.height;
                text: "FlintPlayer";
                color: #d8d8d8;
                font-size: 12px;
                vertical-alignment: center;
            }

            Glyph {
                x: 80px;
                y: (parent.height - 9px) / 2;
                width: 9px;
                height: 9px;
                kind: 24;
                tint: #a8a8a8;
            }

            Rectangle {
                x: 94px;
                y: 8px;
                width: 1px;
                height: parent.height - 16px;
                background: #3a3a3a;
            }

            Text {
                x: 102px;
                y: 0;
                width: 28px;
                height: parent.height;
                text: root.bar-format;
                color: #9a9a9a;
                font-size: 11px;
                vertical-alignment: center;
                visible: root.bar-format != "";
            }

            Rectangle {
                x: 132px;
                y: 8px;
                width: 1px;
                height: parent.height - 16px;
                background: #3a3a3a;
                visible: root.bar-format != "";
            }

            Text {
                x: root.bar-format != "" ? 140px : 102px;
                y: 0;
                width: parent.width - (root.bar-format != "" ? 140px : 102px) - 110px;
                height: parent.height;
                text: root.bar-source;
                color: #b8b8b8;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            IconButton {
                x: parent.width - 124px;
                y: 3px;
                kind: 28;
                glyph-size: 15px;
                tint: root.pinned ? #fae100 : #c8c8c8;
                clicked => { root.toggle-always-on-top(); }
            }

            IconButton {
                x: parent.width - 94px;
                y: 3px;
                kind: 13;
                clicked => { root.minimize-window(); }
            }

            IconButton {
                x: parent.width - 64px;
                y: 3px;
                kind: 14;
                clicked => { root.maximize-window(); }
            }

            IconButton {
                x: parent.width - 34px;
                y: 3px;
                kind: 17;
                danger-hover: true;
                clicked => { root.close-window(); }
            }
        }

        body := Rectangle {
            x: 0;
            y: root.fullscreen || root.video-skin ? 0px : 40px;
            width: parent.width;
            height: parent.height - self.y;
            background: #000000;

            property <length> bar-inset: !root.panel-skin-output && !root.fullscreen && !root.video-skin ? 62px : 0px;

            property <length> content-width: root.sidebar-open && !root.fullscreen
                ? Math.max(320px, self.width - 284px) : self.width;
            property <bool> tiled: root.split-view && !root.fullscreen;
            property <length> active-panel-x: !self.tiled || root.panels.length <= 1 ? 0px
                : (root.panels.length == 2 ? (root.active-index >= 1 ? self.content-width / 2 : 0px)
                : Math.mod(root.active-index, 2) * (self.content-width / 2));
            property <length> active-panel-y: !self.tiled || root.panels.length <= 2 ? 0px
                : (root.active-index >= 2 ? self.height / 2 : 0px);
            property <length> active-panel-width: !self.tiled || root.panels.length <= 1 ? self.content-width : self.content-width / 2;
            property <length> active-panel-height: (!self.tiled || root.panels.length <= 2 ? self.height : self.height / 2) - root.cover-inset - self.bar-inset;
            property <bool> playing: root.panels.length > 0 && root.active-index >= 0 && root.active-index < root.panels.length ? root.panels[root.active-index].running : false;

            for panel[i] in root.panels : CapturePanel {
                x: !parent.tiled || root.panels.length == 1 ? 0px
                    : (root.panels.length == 2 ? i * (parent.content-width / 2) : Math.mod(i, 2) * (parent.content-width / 2));
                y: !parent.tiled || root.panels.length <= 2 ? 0px : (i >= 2 ? parent.height / 2 : 0px);
                width: !parent.tiled || root.panels.length == 1 ? parent.content-width : parent.content-width / 2;
                height: (!parent.tiled || root.panels.length <= 2 ? parent.height : parent.height / 2) - root.cover-inset - parent.bar-inset;
                visible: parent.tiled ? (!root.fullscreen || panel.active) : (panel.active || root.panels.length <= 1);
                frame: panel.frame;
                title: panel.title;
                fps: panel.fps;
                running: panel.running;
                frozen: panel.frozen;
                active: panel.active;
                error: panel.error;
                chrome: parent.tiled && root.panels.length > 1;
                stretch: root.stretch;
                zoom-ratio: root.zoom-ratio;
                zoom-crop: root.zoom-crop;
                zoom-shift-x: root.zoom-shift-x;
                zoom-shift-y: root.zoom-shift-y;
                frame-scale-x: root.frame-scale-x;
                frame-scale-y: root.frame-scale-y;
                margin-bottom: root.margin-effective;
                closable: parent.tiled && root.panels.length > 1;

                picked => {
                    keys.focus();
                    if (root.menu-open) {
                        root.toggle-menu();
                    }
                    root.panel-picked(i);
                }
                double-clicked => {
                    keys.focus();
                    root.panel-toggle-fullscreen(i);
                }
                close-requested => { root.panel-closed(i); }
                right-clicked(x, y) => {
                    root.popup-x = self.x + x;
                    root.popup-y = (root.fullscreen ? 0px : 40px) + self.y + y;
                    root.popup-open = true;
                }
                activity => { root.activity(); }
                panorama: root.pano-enabled;
                touch-mode: root.touch-enabled;
                move-window: !root.move-only-titlebar;
                touch-seek(fraction) => { root.panel-touch-seek(i, fraction); }
                window-drag(dx, dy) => { root.window-drag(dx, dy); }
                pano-moved(dx, dy) => { root.pano-drag(dx, dy); }
                pano-zoomed(delta) => { root.pano-zoom(delta); }
            }

            Image {
                x: parent.active-panel-x + parent.active-panel-width - self.width - 16px;
                y: parent.active-panel-y + 16px;
                width: Math.max(24px, Math.min(160px, parent.active-panel-width / 4));
                height: Math.max(24px, Math.min(160px, parent.active-panel-height / 4));
                source: root.logo-image;
                image-fit: contain;
                visible: root.logo-visible && !parent.playing;
            }

            Image {
                x: parent.active-panel-x + parent.active-panel-width - self.width - 16px;
                y: parent.active-panel-y + 16px;
                width: Math.max(24px, Math.min(160px, parent.active-panel-width / 4));
                height: Math.max(24px, Math.min(160px, parent.active-panel-height / 4));
                source: root.play-logo-image;
                image-fit: contain;
                visible: root.play-logo-visible && parent.playing;
            }

            Rectangle {
                visible: root.panels.length == 0;
                x: (parent.content-width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 430px;
                height: 96px;
                background: transparent;

                Rectangle {
                    x: 0;
                    y: 8px;
                    width: 80px;
                    height: 80px;
                    border-radius: 40px;
                    background: #1d1d1d;

                    Text {
                        text: "▶";
                        color: #565656;
                        font-size: 36px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }

                Text {
                    x: 98px;
                    y: 8px;
                    width: 332px;
                    height: 80px;
                    text: "FlintPlayer";
                    color: #3c3c3c;
                    font-size: 45px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }



            osd := OsdTab {
                x: 18px + parent.active-panel-x;
                y: 18px + parent.active-panel-y;
                width: Math.max(0px, parent.active-panel-width - 36px);
                text-size: Math.max(11px, Math.min(30px, Math.min(parent.active-panel-height * 0.03, parent.active-panel-width / 40)));
                visible: root.osd-visible;
                file: root.osd-file;
                time: root.osd-time;
                config: root.osd-config;
                version: root.osd-version;
                decoder: root.osd-decoder;
                input: root.osd-input;
                format: root.osd-format;
                output: root.osd-output;
                renderer: root.osd-renderer;
                pixel: root.osd-pixel;
                frames: root.osd-frames;
                frame-size: root.osd-frame-size;
                audio: root.osd-audio;
            }

            osd-brief-box := Rectangle {
                x: 18px + parent.active-panel-x;
                y: 18px + parent.active-panel-y;
                width: Math.max(0px, parent.active-panel-width - 36px);
                height: brief-text.preferred-height + 10px;
                background: #00000099;
                border-radius: 3px;
                visible: root.osd-brief && root.osd-brief-text != "";

                brief-text := Text {
                    x: 8px;
                    y: 5px;
                    width: parent.width - 16px;
                    text: root.osd-brief-text;
                    color: #e8e8e8;
                    font-size: 14px;
                    font-family: "Noto Sans CJK SC";
                    font-weight: 700;
                    overflow: elide;
                }
            }

            osd-playback-box := Rectangle {
                x: 18px + parent.active-panel-x;
                y: 18px + parent.active-panel-y;
                width: Math.min(460px, Math.max(0px, parent.active-panel-width - 36px));
                height: playback-text.preferred-height + 12px;
                background: #000000b3;
                border-radius: 3px;
                visible: root.osd-playback && root.osd-playback-text != "";

                playback-text := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: root.osd-playback-text;
                    color: #e8e8e8;
                    font-size: 13px;
                    font-family: "Noto Sans CJK SC";
                    vertical-alignment: top;
                    wrap: word-wrap;
                }
            }

            subtitle-box := Rectangle {
                x: parent.active-panel-x + parent.active-panel-width * 0.06;
                y: root.subtitle-top || root.subtitle-cue-top
                    ? parent.active-panel-y + 40px
                    : parent.active-panel-y + parent.active-panel-height - self.height - 78px;
                width: parent.active-panel-width * 0.88;
                height: Math.min(140px, parent.active-panel-height * 0.2);
                background: transparent;
                property <bool> has-translation: root.subtitle-translation != "" && root.subtitle-3d-mode == "off" && !(root.manual-open && root.manual-text != "");
                property <length> translation-height: self.has-translation ? Math.min(64px, self.height / 3) : 0px;
                visible: ((root.manual-open && root.manual-text != "") || (root.subtitles-visible && root.subtitle-text != ""));

                Text {
                    x: 0;
                    y: 1px;
                    width: parent.width;
                    height: root.subtitle-top || root.subtitle-cue-top ? parent.height : parent.height - parent.translation-height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: #000000;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-shadow && root.subtitle-3d-mode == "off";
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: root.subtitle-top || root.subtitle-cue-top ? parent.height : parent.height - parent.translation-height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: root.subtitle-cue-color;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "off";
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width / 2;
                    height: parent.height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: root.subtitle-cue-color;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "sbs";
                }

                Text {
                    x: parent.width / 2;
                    y: 0;
                    width: parent.width / 2;
                    height: parent.height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: root.subtitle-cue-color;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "sbs";
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height / 2;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: root.subtitle-cue-color;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(10px, Math.min(22px, parent.height / 8)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "tab";
                }

                Text {
                    x: 0;
                    y: parent.height / 2;
                    width: parent.width;
                    height: parent.height / 2;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: root.subtitle-cue-color;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(10px, Math.min(22px, parent.height / 8)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "tab";
                }

                Text {
                    x: -4px;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: #ff4040;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "anaglyph";
                }

                Text {
                    x: 4px;
                    y: 1px;
                    width: parent.width;
                    height: parent.height;
                    text: root.manual-open && root.manual-text != "" ? root.manual-text : root.subtitle-text;
                    color: #40d8ff;
                    font-family: root.subtitle-cue-font != "" ? root.subtitle-cue-font : root.subtitle-font-family;
                    font-weight: root.subtitle-bold || root.subtitle-cue-bold ? 700 : 400;
                    font-size: Math.max(12px, Math.min(30px, parent.height / 4)) * root.subtitle-scale * root.subtitle-cue-scale;
                    horizontal-alignment: center;
                    vertical-alignment: root.subtitle-top || root.subtitle-cue-top ? top : bottom;
                    wrap: word-wrap;
                    visible: root.subtitle-3d-mode == "anaglyph";
                }

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.subtitle-translation;
                    color: #9fd8ff;
                    font-family: root.subtitle-font-family != "" ? root.subtitle-font-family : "Noto Sans CJK SC";
                    font-size: Math.max(10px, Math.min(22px, parent.height / 7));
                    horizontal-alignment: center;
                    vertical-alignment: bottom;
                    wrap: word-wrap;
                    visible: parent.has-translation;
                }
            }

            Rectangle {
                x: parent.active-panel-x + (parent.active-panel-width - self.width) / 2;
                y: parent.active-panel-y + parent.active-panel-height - self.height - 72px;
                width: Math.min(560px, parent.active-panel-width - 32px);
                height: 38px;
                border-radius: 6px;
                background: #000000d0;
                border-width: 1px;
                border-color: #6a2a24;
                visible: root.status-error != "";

                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 24px;
                    text: root.status-error;
                    color: #ff8b80;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            Rectangle {
                x: parent.active-panel-x + parent.active-panel-width - self.width - 16px;
                y: parent.active-panel-y + (root.panels.length > 1 && !root.fullscreen ? 32px : 14px);
                width: 72px;
                height: 24px;
                border-radius: 4px;
                background: #000000a0;
                visible: root.frozen;

                Text {
                    text: Translation.tr("已冻结", Translation.language-gen);
                    color: #fae100;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            ControlBar {
                x: parent.active-panel-x;
                y: parent.active-panel-y + parent.active-panel-height + root.cover-inset - self.height;
                width: parent.active-panel-width;
                visible: (!root.fullscreen && !root.video-skin) || root.chrome-visible;
                running: root.running;
                paused: root.frozen;
                recording: root.recording;
                osd-visible: root.osd-visible;
                menu-open: root.menu-open;
                fullscreen: root.fullscreen;
                sidebar-open: root.sidebar-open;
                progress: root.bar-progress;
                bookmarks: root.bar-bookmarks;
                chapters: root.bar-chapters;
                accent: root.skin-accent;
                volume: root.volume;
                muted: root.muted;
                elapsed: root.bar-elapsed;
                duration: root.bar-duration;
                seek-hover-time: root.seek-hover-time;
                codec: root.bar-codec;
                size: root.bar-size;
                rate: root.bar-rate;
                bitrate: root.bar-bitrate;
                source: root.bar-source;

                main-menu => {
                    root.popup-x = root.width - 280px;
                    root.popup-y = root.height;
                    root.popup-open = true;
                }
                settings-requested => { root.settings-open = true; }
                play-pause => { root.menu-command("play-pause"); }
                stop-requested => { root.stop-requested(); }
                previous-panel => { root.panel-prev(); }
                next-panel => { root.panel-next(); }
                open-requested => { root.menu-command("open-default"); }
                toggle-sidebar => {
                    root.sidebar-open = !root.sidebar-open;
                    keys.focus();
                }
                activity => { root.activity(); }
                right-clicked(x, y) => {
                    root.popup-x = self.x + x;
                    root.popup-y = self.y + y;
                    root.popup-open = true;
                }
                seek-requested(value) => { root.seek-requested(value); }
                seek-preview(value) => { root.seek-preview(value); }
                volume-requested(value) => {
                    root.volume = value;
                    root.volume-changed(value);
                }
                toggle-mute => {
                    root.muted = !root.muted;
                    root.volume-changed(root.muted ? 0.0 : root.volume);
                }
            }

            Sidebar {
                x: parent.content-width;
                y: 0px;
                width: parent.width - self.x;
                height: parent.height;
                visible: root.sidebar-open && !root.fullscreen;
                panels: root.panels;
                selected: root.active-index;
                browser-path: root.browser-path;
                browser-items: root.browser-items;
                accent: root.skin-accent;

                item-picked(index) => { root.panel-picked(index); keys.focus(); }
                close-sidebar => { root.sidebar-open = false; keys.focus(); }
                browser-navigate(path) => { root.browser-navigate(path); }
                browser-open(path) => { root.browser-open(path); }
                browser-up => { root.browser-up(); }
                add-requested => { root.menu-command("open-file"); }
                delete-requested => {
                    if (root.panels.length > 0 && root.active-index >= 0) {
                        root.panel-closed(root.active-index);
                    }
                }
            }

            menu := DeviceMenu {
                x: 0px;
                y: 0px;
                width: 300px;
                height: parent.height;
                visible: root.menu-open;
                devices: root.devices;
                resolutions: root.resolutions;
                formats: root.formats;
                selected-device: root.selected-device;
                selected-resolution: root.selected-resolution;
                selected-format: root.selected-format;
                network-url <=> root.network-url;
                running: root.running;

                device-picked(index) => { root.device-picked(index); keys.focus(); }
                resolution-picked(index) => { root.resolution-picked(index); keys.focus(); }
                format-picked(index) => { root.format-picked(index); keys.focus(); }
                refresh => { root.refresh-devices(); }
                connect-network(url) => { root.connect-network(url); keys.focus(); }
                start-requested => { root.start-requested(); }
                stop-requested => { root.stop-requested(); }
                close-requested => { root.toggle-menu(); keys.focus(); }
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;
        visible: root.popup-open;

        changed visible => {
            if (!self.visible && popup.open-index >= 0) {
                popup.open-index = -1;
            }
        }

        backdrop := Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: transparent;

            TouchArea {
                clicked => { root.popup-open = false; }
            }
        }

        popup := MenuPopup {
            x: Math.max(0px, Math.min(root.popup-x, root.width - self.width - 4px));
            y: Math.max(0px, Math.min(root.popup-y, root.height - self.height - 4px));
            container-width: root.width;
            container-height: root.height;
            limit-height: root.height - 8px;
            menu-alpha: root.skin-opacity;
            menu-bg: root.effective-menu-bg;
            menu-hover: root.effective-menu-hover;
            menu-scale: root.menu-scale;
            menu-text: root.menu-text-color;
            menu-dim: root.menu-dim-color;
            menu-lit: root.menu-lit-color;
            menu-shortcut-color: root.menu-shortcut-color;
            menu-check: root.menu-check-color;
            chosen(cmd) => {
                root.popup-open = false;
                root.menu-command(cmd);
                keys.focus();
            }
            entries: [
                { title: Translation.tr("打开文件...", Translation.language-gen), shortcut: "F3", enabled: true, checkable: false, checked: false, separator: false, command: "open-file", children: [] },
                { title: Translation.tr("打开", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, separator: false, command: "", children: [
                    { title: Translation.tr("打开文件...", Translation.language-gen), shortcut: "Ctrl+O", enabled: true, checkable: false, checked: false, arrow: false, command: "open-file", children: [] },
                    { title: Translation.tr("打开链接...", Translation.language-gen), shortcut: "Ctrl+U", enabled: true, checkable: false, checked: false, arrow: false, command: "open-network", children: [] },
                    { title: Translation.tr("打开文件夹...", Translation.language-gen), shortcut: "F2", enabled: true, checkable: false, checked: false, arrow: false, command: "open-folder", children: [] },
                    { title: Translation.tr("打开远程连接...", Translation.language-gen), shortcut: "Alt+F12", enabled: true, checkable: false, checked: false, arrow: false, command: "open-network", children: [] },
                    { title: Translation.tr("打开剪贴板", Translation.language-gen), shortcut: "Ctrl+V", enabled: true, checkable: false, checked: false, arrow: false, command: "open-clipboard", children: [] },
                    { title: Translation.tr("", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("采集器", Translation.language-gen), shortcut: "Ctrl+S", enabled: true, checkable: false, checked: false, arrow: false, command: "open-device", children: [] },
                    { title: Translation.tr("摄像头/其他设备", Translation.language-gen), shortcut: "Ctrl+J", enabled: true, checkable: false, checked: false, arrow: false, command: "open-device", children: [] },
                    { title: Translation.tr("模拟TV", Translation.language-gen), shortcut: "Ctrl+W", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("数字 TV(BDA 设备)", Translation.language-gen), shortcut: "Ctrl+K", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("设备设置...", Translation.language-gen), shortcut: "Alt+D", enabled: true, checkable: false, checked: false, arrow: false, command: "device-settings", children: [] },
                    { title: Translation.tr("", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("DVD 设备", Translation.language-gen), shortcut: "Ctrl+D", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("DVD 文件(*.IFO)...", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("蓝光设备", Translation.language-gen), shortcut: "Ctrl+Alt+D", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("蓝光文件(*.MPLS)...", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "", children: [] },
                    { title: Translation.tr("打开字幕...", Translation.language-gen), shortcut: "Alt+O", enabled: true, checkable: false, checked: false, arrow: false, command: "subtitle-open", children: [] },
                    { title: Translation.tr("添加字幕...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "subtitle-open", children: [] },
                    { title: Translation.tr("添加次字幕...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "subtitle-secondary-open", children: [] },
                    { title: Translation.tr("重载字幕", Translation.language-gen), shortcut: "Ctrl+Alt+Y", enabled: true, checkable: false, checked: false, arrow: false, command: "subtitle-reload", children: [] },
                    { title: Translation.tr("重开当前/最后文件", Translation.language-gen), shortcut: "Ctrl+Y", enabled: true, checkable: false, checked: false, arrow: false, command: "reopen", children: [] },
                    { title: Translation.tr("载入音频...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "load-audio", children: [] }
                ] },
                { title: Translation.tr("首选打开方式", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, separator: false, command: "", children: [
                    { title: Translation.tr("打开文件", Translation.language-gen), shortcut: "", enabled: true, checkable: true, checked: root.default-open-action == "file", arrow: false, command: "default-open-file" },
                    { title: Translation.tr("打开链接", Translation.language-gen), shortcut: "", enabled: true, checkable: true, checked: root.default-open-action == "url", arrow: false, command: "default-open-url" },
                    { title: Translation.tr("打开文件夹", Translation.language-gen), shortcut: "", enabled: true, checkable: true, checked: root.default-open-action == "folder", arrow: false, command: "default-open-folder" },
                    { title: Translation.tr("简索", Translation.language-gen), shortcut: "", enabled: true, checkable: true, checked: root.default-open-action == "navigate", arrow: false, command: "default-open-navigate" }
                ] },
                { title: Translation.tr("简索", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, separator: false, command: "", children: [
                    { title: Translation.tr("简索文件...", Translation.language-gen), shortcut: "F12", enabled: true, checkable: false, checked: false, arrow: false, command: "open-file" },
                    { title: Translation.tr("简索字幕...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "subtitle-open" },
                    { title: Translation.tr("简索专辑...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "open-folder" },
                    { title: Translation.tr("简索地址...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "open-url" },
                    { title: Translation.tr("简索 FTP/WebDAV/HTTP...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "open-url" },
                    { title: Translation.tr("简索书签...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "navigate-bookmarks" },
                    { title: Translation.tr("简索菜单...", Translation.language-gen), shortcut: "Ctrl+F12", enabled: true, checkable: false, checked: false, arrow: false, command: "menu-search" },
                    { title: Translation.tr("简索直播...", Translation.language-gen), shortcut: "", enabled: false, checkable: false, checked: false, arrow: false, command: "" },
                    { title: Translation.tr("简索播放中...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "toggle-sidebar" },
                    { title: Translation.tr("简索设置...", Translation.language-gen), shortcut: "", enabled: true, checkable: false, checked: false, arrow: false, command: "navigate-settings" }
