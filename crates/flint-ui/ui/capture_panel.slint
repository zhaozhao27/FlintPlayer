import { Glyph } from "icons.slint";
import { Translation } from "translation.slint";

export struct PanelInfo {
    frame: image,
    title: string,
    fps: string,
    running: bool,
    frozen: bool,
    active: bool,
    error: string,
}

export component CapturePanel inherits Rectangle {
    in property <image> frame;
    in property <string> title: "";
    in property <string> fps: "";
    in property <bool> running: false;
    in property <bool> frozen: false;
    in property <bool> active: false;
    in property <string> error: "";
    in property <bool> chrome: true;
    in property <bool> stretch: false;
    in property <int> zoom-ratio: 0;
    in property <bool> zoom-crop: false;
    in property <int> zoom-shift-x: 0;
    in property <int> zoom-shift-y: 0;
    in property <int> frame-scale-x: 100;
    in property <int> frame-scale-y: 100;
    in property <int> margin-bottom: 0;
    in property <bool> closable: false;
    in property <bool> panorama: false;
    in property <bool> touch-mode: false;
    in property <bool> move-window: false;

    callback picked;
    callback double-clicked;
    callback close-requested;
    callback activity;
    callback right-clicked(length, length);
    callback pano-moved(length, length);
    callback pano-zoomed(float);
    callback touch-seek(float);
    callback window-drag(length, length);

    property <bool> pano-dragging: false;
    property <length> pano-x: 0px;
    property <length> pano-y: 0px;
    property <bool> touch-dragging: false;
    property <length> touch-x: 0px;
    property <bool> window-dragging: false;
    property <length> window-x: 0px;
    property <length> window-y: 0px;
    property <length> drag-dx: 0px;
    property <length> drag-dy: 0px;

    background: #050505;
    border-width: !root.chrome ? 0px : (root.active ? 2px : 1px);
    border-color: root.active && root.chrome ? #fae100 : #1c1c1c;
    clip: true;

    Image {
        property <float> zoom-aspect: root.zoom-ratio / 1000.0;
        property <float> video-aspect: root.frame.width > 0 && root.frame.height > 0 ? root.frame.width / root.frame.height : parent.width / parent.height;
        property <length> area-height: parent.height * (100 - root.margin-bottom) / 100;
        property <length> fit-w: root.zoom-ratio > 0 ? Math.min(parent.width, self.area-height * self.zoom-aspect)
            : (root.stretch ? parent.width : Math.min(parent.width, self.area-height * self.video-aspect));
        property <length> fit-h: root.zoom-ratio > 0 ? Math.min(self.area-height, parent.width / self.zoom-aspect)
            : (root.stretch ? self.area-height : Math.min(self.area-height, parent.width / self.video-aspect));
        property <length> frame-w: self.fit-w * root.frame-scale-x / 100;
        property <length> frame-h: self.fit-h * root.frame-scale-y / 100;
        x: (parent.width - self.frame-w) / 2 + parent.width * root.zoom-shift-x / 100;
        y: (self.area-height - self.frame-h) / 2 + parent.height * root.zoom-shift-y / 100;
        width: self.frame-w;
        height: self.frame-h;
        source: root.frame;
        image-fit: root.zoom-crop ? cover : fill;
        image-rendering: smooth;
    }

    touch := TouchArea {
        moved => {
            root.activity();
            if (root.move-window && !root.panorama) {
                if (touch.pressed && !root.window-dragging) {
                    root.window-dragging = true;
                    root.window-x = touch.mouse-x;
                    root.window-y = touch.mouse-y;
                } else if (touch.pressed && root.window-dragging) {
                    root.drag-dx = touch.mouse-x - root.window-x;
                    root.drag-dy = touch.mouse-y - root.window-y;
                    root.window-drag(root.drag-dx, root.drag-dy);
                    root.window-x = touch.mouse-x - root.drag-dx;
                    root.window-y = touch.mouse-y - root.drag-dy;
                } else {
                    root.window-dragging = false;
                }
            }
        }
        clicked => { root.picked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) {
                root.activity();
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.right-clicked(touch.mouse-x, touch.mouse-y);
            }
            if (root.panorama) {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.pano-dragging = true;
                    root.pano-x = touch.mouse-x;
                    root.pano-y = touch.mouse-y;
                }
                if (event.kind == PointerEventKind.up) {
                    root.pano-dragging = false;
                }
                if (event.kind == PointerEventKind.move && root.pano-dragging) {
                    root.pano-moved(touch.mouse-x - root.pano-x, touch.mouse-y - root.pano-y);
                    root.pano-x = touch.mouse-x;
                    root.pano-y = touch.mouse-y;
                }
            }
            if (root.touch-mode && !root.panorama && event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.touch-dragging = true;
                    root.touch-x = touch.mouse-x;
                }
                if (event.kind == PointerEventKind.up && root.touch-dragging) {
                    root.touch-dragging = false;
                    root.touch-seek((touch.mouse-x - root.touch-x) / root.width);
                }
            }
        }
        scroll-event(event) => {
            if (root.panorama) {
                root.pano-zoomed(event.delta-y / 1px);
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        visible: root.chrome;
        x: 0;
        y: 0;
        width: parent.width;
        height: 24px;
        background: #000000a8;

        Text {
            x: 8px;
            y: 0;
            width: parent.width - 154px;
            height: parent.height;
            text: root.title;
            color: root.active ? #ffffff : #c0c0c0;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Glyph {
            x: parent.width - 140px;
            y: 7px;
            width: 10px;
            height: 10px;
            kind: 1;
            tint: #fae100;
            visible: root.frozen;
        }

        Text {
            x: parent.width - 132px;
            y: 0;
            width: 100px;
            height: parent.height;
            text: root.fps;
            color: #9a9a9a;
            font-size: 10px;
            font-family: "monospace";
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            visible: root.running;
        }
    }

    close := Rectangle {
        x: parent.width - 26px;
        y: 2px;
        width: 24px;
        height: 24px;
        border-radius: 3px;
        background: close-touch.has-hover ? #c42b1c : (root.chrome ? #000000a8 : transparent);
        visible: root.closable && root.active && (root.chrome || touch.has-hover || close-touch.has-hover);

        Glyph {
            x: 7px;
            y: 7px;
            width: 10px;
            height: 10px;
            kind: 17;
            tint: close-touch.has-hover ? #ffffff : (#b8b8b8);
        }

        close-touch := TouchArea {
            clicked => { root.close-requested(); }
        }
    }

    Text {
        y: (parent.height - self.height) / 2 - 8px;
        width: parent.width;
        text: Translation.tr("无信号", Translation.language-gen);
        color: #6a6a6a;
        font-size: 14px;
        horizontal-alignment: center;
        visible: !root.running;
    }

    Text {
        x: 10px;
        y: parent.height - 30px;
        width: parent.width - 20px;
        height: 22px;
        text: root.error;
        color: #ff8b80;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        visible: root.error != "";
    }
}
