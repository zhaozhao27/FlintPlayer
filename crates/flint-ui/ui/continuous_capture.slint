import { Translation } from "translation.slint";
component BurstButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component ContinuousCaptureDialog inherits Rectangle {
    in-out property <string> interval-text: "1000";
    in-out property <string> count-text: "10";
    in property <string> status: "";
    callback start-capture(string, string);
    callback close;

    width: 440px;
    height: 190px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 46px;
            height: parent.height;
            text: Translation.tr("连续截图", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Text {
        x: 20px;
        y: 44px;
        width: 130px;
        height: 24px;
        text: Translation.tr("间隔（毫秒）：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 156px;
        y: 44px;
        width: 180px;
        height: 24px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        interval-edit := TextInput {
            x: 6px;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.interval-text;
            color: #1a1a1a;
            font-size: 11px;
            single-line: true;
            accepted => { root.start-capture(root.interval-text, root.count-text); }
        }
    }

    Text {
        x: 20px;
        y: 78px;
        width: 130px;
        height: 24px;
        text: Translation.tr("张数：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 156px;
        y: 78px;
        width: 180px;
        height: 24px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        count-edit := TextInput {
            x: 6px;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.count-text;
            color: #1a1a1a;
            font-size: 11px;
            single-line: true;
            accepted => { root.start-capture(root.interval-text, root.count-text); }
        }
    }

    Text {
        x: 20px;
        y: 108px;
        width: parent.width - 40px;
        height: 18px;
        text: root.status;
        color: #4a4a4a;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    BurstButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("开始", Translation.language-gen);
        primary: true;
        clicked => { root.start-capture(root.interval-text, root.count-text); }
    }

    BurstButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}

export component ThumbnailDialog inherits Rectangle {
    in-out property <string> width-text: "320";
    in property <string> directory: "";
    in property <string> status: "";
    callback create-thumbnail(string);
    callback close;

    width: 440px;
    height: 172px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 46px;
            height: parent.height;
            text: Translation.tr("创建缩略图", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Text {
        x: 20px;
        y: 44px;
        width: 130px;
        height: 24px;
        text: Translation.tr("宽度（像素）：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 156px;
        y: 44px;
        width: 180px;
        height: 24px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        TextInput {
            x: 6px;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.width-text;
            color: #1a1a1a;
            font-size: 11px;
            single-line: true;
            accepted => { root.create-thumbnail(root.width-text); }
        }
    }

    Text {
        x: 20px;
        y: 78px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("输出目录：", Translation.language-gen) + root.directory;
        color: #4a4a4a;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 20px;
        y: 100px;
        width: parent.width - 40px;
        height: 18px;
        text: root.status;
        color: #4a4a4a;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    BurstButton {
        x: parent.width - 188px;
        y: parent.height - 36px;
        width: 88px;
        label: Translation.tr("创建", Translation.language-gen);
        primary: true;
        clicked => { root.create-thumbnail(root.width-text); }
    }

    BurstButton {
        x: parent.width - 92px;
        y: parent.height - 36px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}
