import { ScrollView } from "std-widgets.slint";
import { Translation } from "translation.slint";

export struct FileEntry {
    name: string,
    path: string,
    is-dir: bool,
    size: string,
}

component DlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component FileDialog inherits Rectangle {
    in property <string> dir: "";
    in property <[FileEntry]> entries: [];
    in property <bool> folder-mode: false;
    in-out property <int> selected: -1;
    in-out property <string> path-input: "";

    callback navigate(string);
    callback picked(int);
    callback open-selected;
    callback choose-dir(string);
    callback close;

    width: 620px;
    height: 460px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: root.folder-mode ? Translation.tr("打开文件夹", Translation.language-gen) : Translation.tr("打开文件", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    DlgButton {
        x: 8px;
        y: 34px;
        width: 56px;
        label: Translation.tr("上级", Translation.language-gen);
        clicked => { root.navigate(".."); }
    }

    Rectangle {
        x: 72px;
        y: 34px;
        width: parent.width - 80px;
        height: 23px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        path-edit := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: root.path-input;
            font-size: 11px;
            color: #1a1a1a;
            single-line: true;
            edited => { root.path-input = path-edit.text; }
            accepted => { root.navigate(root.path-input); }
        }
    }

    Rectangle {
        x: 8px;
        y: 64px;
        width: parent.width - 16px;
        height: parent.height - 64px - 40px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;
        clip: true;

        ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;

            VerticalLayout {
                for entry[index] in root.entries : Rectangle {
                    height: 24px;

                    background: index == root.selected ? #cfe4f7 : (row-touch.has-hover ? #e8f2fb : transparent);

                    Text {
                        x: 8px;
                        y: 0;
                        width: parent.width - 124px;
                        height: parent.height;
                        text: entry.name;
                        color: entry.is-dir ? #1f4e78 : #1a1a1a;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - 116px;
                        y: 0;
                        width: 106px;
                        height: parent.height;
                        text: entry.size;
                        color: #7a7a7a;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.selected = index;
                            root.picked(index);
                        }
                    }
                }
            }
        }
    }

    DlgButton {
        x: parent.width - 176px;
        y: parent.height - 32px;
        width: 76px;
        label: root.folder-mode ? Translation.tr("选择文件夹", Translation.language-gen) : Translation.tr("打开(O)", Translation.language-gen);
        primary: true;
        clicked => {
            if (root.folder-mode) {
                root.choose-dir(root.dir);
            } else {
                root.open-selected();
            }
        }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}
