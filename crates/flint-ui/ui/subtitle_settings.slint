import { Translation } from "translation.slint";
export struct SkinRow {
    label: string,
    kind: int,
    index: int,
}

component SubDlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 23px;
    background: !root.enabled
        ? #ececec
        : root.active
            ? (ta.has-hover ? #bcdcff : #cfe6ff)
            : (root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4));
    border-width: 1px;
    border-color: root.active ? #4a90d9 : #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component SubDlgCheck inherits Rectangle {
    in property <string> label: "";
    in property <bool> checked: false;
    callback toggled;

    height: 20px;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;

        Text {
            x: 0;
            y: -2px;
            width: parent.width;
            height: parent.height;
            text: "✓";
            color: #1a5fa8;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            visible: root.checked;
        }
    }

    Text {
        x: 19px;
        y: 0;
        width: parent.width - 19px;
        height: parent.height;
        text: root.label;
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

component SubDlgHeader inherits Rectangle {
    in property <string> title: "";
    callback close;

    height: 28px;
    background: #1f1f1f;

    Text {
        x: 10px;
        y: 0;
        width: parent.width - 50px;
        height: parent.height;
        text: root.title;
        color: #eeeeee;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 30px;
        y: 0;
        width: 20px;
        height: parent.height;
        text: "✕";
        color: #d0d0d0;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    close-touch := TouchArea {
        x: parent.width - 36px;
        y: 0;
        width: 36px;
        height: parent.height;
        clicked => { root.close(); }
    }
}

export component SubtitleSettings inherits Rectangle {
    in-out property <string> font-name: "系统默认";
    in-out property <float> scale: 1;
    in-out property <string> color-name: "white";
    in-out property <bool> top: false;
    in-out property <bool> bold: false;
    in-out property <bool> shadow: true;
    in property <float> delay: 0;
    in property <bool> has-subtitle: false;

    callback command(string);
    callback close;

    width: 520px;
    height: 352px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    SubDlgHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: Translation.tr("字幕设置", Translation.language-gen);
        close => { root.close(); }
    }

    Text {
        x: 20px;
        y: 46px;
        width: 70px;
        height: 23px;
        text: Translation.tr("字体", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: 90px;
        y: 46px;
        width: 26px;
        label: "◀";
        clicked => { root.command("subtitle-font-step--1"); }
    }

    Rectangle {
        x: 120px;
        y: 46px;
        width: 220px;
        height: 23px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.font-name;
            color: #1a1a1a;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    SubDlgButton {
        x: 344px;
        y: 46px;
        width: 26px;
        label: "▶";
        clicked => { root.command("subtitle-font-step-1"); }
    }

    Text {
        x: 20px;
        y: 82px;
        width: 70px;
        height: 23px;
        text: Translation.tr("字号", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: 90px;
        y: 82px;
        width: 66px;
        label: Translation.tr("小", Translation.language-gen);
        active: root.scale < 0.9;
        clicked => { root.command("subtitle-size-0.8"); }
    }

    SubDlgButton {
        x: 162px;
        y: 82px;
        width: 66px;
        label: Translation.tr("中", Translation.language-gen);
        active: root.scale >= 0.9 && root.scale < 1.15;
        clicked => { root.command("subtitle-size-1"); }
    }

    SubDlgButton {
        x: 234px;
        y: 82px;
        width: 66px;
        label: Translation.tr("大", Translation.language-gen);
        active: root.scale >= 1.15 && root.scale < 1.4;
        clicked => { root.command("subtitle-size-1.3"); }
    }

    SubDlgButton {
        x: 306px;
        y: 82px;
        width: 66px;
        label: Translation.tr("特大", Translation.language-gen);
        active: root.scale >= 1.4;
        clicked => { root.command("subtitle-size-1.6"); }
    }

    Text {
        x: 20px;
        y: 118px;
        width: 70px;
        height: 23px;
        text: Translation.tr("颜色", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: 90px;
        y: 118px;
        width: 66px;
        label: Translation.tr("白色", Translation.language-gen);
        active: root.color-name == "white";
        clicked => { root.command("subtitle-color-white"); }
    }

    SubDlgButton {
        x: 162px;
        y: 118px;
        width: 66px;
        label: Translation.tr("黄色", Translation.language-gen);
        active: root.color-name == "yellow";
        clicked => { root.command("subtitle-color-yellow"); }
    }

    SubDlgButton {
        x: 234px;
        y: 118px;
        width: 66px;
        label: Translation.tr("青色", Translation.language-gen);
        active: root.color-name == "cyan";
        clicked => { root.command("subtitle-color-cyan"); }
    }

    SubDlgButton {
        x: 306px;
        y: 118px;
        width: 66px;
        label: Translation.tr("绿色", Translation.language-gen);
        active: root.color-name == "green";
        clicked => { root.command("subtitle-color-green"); }
    }

    Text {
        x: 20px;
        y: 154px;
        width: 70px;
        height: 23px;
        text: Translation.tr("位置", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: 90px;
        y: 154px;
        width: 66px;
        label: Translation.tr("底部", Translation.language-gen);
        active: !root.top;
        clicked => { root.command("subtitle-pos-bottom"); }
    }

    SubDlgButton {
        x: 162px;
        y: 154px;
        width: 66px;
        label: Translation.tr("顶部", Translation.language-gen);
        active: root.top;
        clicked => { root.command("subtitle-pos-top"); }
    }

    SubDlgCheck {
        x: 306px;
        y: 155px;
        width: 70px;
        label: Translation.tr("粗体", Translation.language-gen);
        checked: root.bold;
        toggled => { root.command("subtitle-bold-toggle"); }
    }

    SubDlgCheck {
        x: 386px;
        y: 155px;
        width: 70px;
        label: Translation.tr("阴影", Translation.language-gen);
        checked: root.shadow;
        toggled => { root.command("subtitle-shadow-toggle"); }
    }

    Text {
        x: 20px;
        y: 190px;
        width: 70px;
        height: 23px;
        text: Translation.tr("字幕延迟", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 90px;
        y: 190px;
        width: 90px;
        height: 23px;
        text: (root.delay >= 0 ? "+" : "") + Math.round(root.delay * 10) / 10 + Translation.tr(" 秒", Translation.language-gen);
        color: root.has-subtitle ? #1a5fa8 : #8a8a8a;
        font-size: 12px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: 186px;
        y: 190px;
        width: 52px;
        label: "-0.5";
        enabled: root.has-subtitle;
        clicked => { root.command("subtitle-delay--0.5"); }
    }

    SubDlgButton {
        x: 242px;
        y: 190px;
        width: 52px;
        label: "-0.1";
        enabled: root.has-subtitle;
        clicked => { root.command("subtitle-delay--0.1"); }
    }

    SubDlgButton {
        x: 298px;
        y: 190px;
        width: 52px;
        label: "+0.1";
        enabled: root.has-subtitle;
        clicked => { root.command("subtitle-delay-0.1"); }
    }

    SubDlgButton {
        x: 354px;
        y: 190px;
        width: 52px;
        label: "+0.5";
        enabled: root.has-subtitle;
        clicked => { root.command("subtitle-delay-0.5"); }
    }

    SubDlgButton {
        x: 410px;
        y: 190px;
        width: 66px;
        label: Translation.tr("复位", Translation.language-gen);
        enabled: root.has-subtitle;
        clicked => { root.command("subtitle-delay-reset"); }
    }

    Rectangle {
        x: 20px;
        y: 228px;
        width: parent.width - 40px;
        height: 1px;
        background: #c9c9c9;
    }

    Text {
        x: 20px;
        y: 240px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("更改会立即生效并保存到配置文件；字幕样式作用于已加载的字幕。", Translation.language-gen);
        color: #6a6a6a;
        font-size: 11px;
        vertical-alignment: center;
    }

    SubDlgButton {
        x: parent.width - 100px;
        y: parent.height - 34px;
        width: 80px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.close(); }
    }
}

export component SubtitleInput inherits Rectangle {
    in-out property <string> text: "";
    in property <string> title: "手动输入字幕";
    in property <string> hint: "输入要在画面上显示的字幕内容，按回车关闭";
    in property <bool> active: false;
    callback close;

    width: 440px;
    height: 156px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    SubDlgHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: root.title;
        close => { root.close(); }
    }

    Text {
        x: 16px;
        y: 40px;
        width: parent.width - 32px;
        height: 18px;
        text: root.hint;
        color: #4a4a4a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 16px;
        y: 64px;
        width: parent.width - 32px;
        height: 28px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        input := TextInput {
            x: 6px;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text: root.text;
            font-size: 13px;
            color: #1a1a1a;
            single-line: true;
            edited => { root.text = input.text; }
            accepted => { root.close(); }
        }
    }

    changed active => {
        if (self.active) {
            input.focus();
        }
    }

    SubDlgButton {
        x: parent.width - 100px;
        y: parent.height - 34px;
        width: 80px;
        label: Translation.tr("关闭", Translation.language-gen);
        primary: true;
        clicked => { root.close(); }
    }
}

export component SkinSettings inherits Rectangle {
    in-out property <float> alpha: 1;
    in property <bool> autohide: true;
    in property <bool> no-cover: false;
    in property <[SkinRow]> rows: [];
    in-out property <int> selected: -1;
    property <length> content-height: root.rows.length * 22px;
    property <length> max-offset: Math.max(0px, content-height - 214px);
    property <length> scroll-offset: 0px;

    callback opacity-changed(float);
    callback command(string);
    callback pick(int);
    callback browse;
    callback confirm;
    callback cancel;

    width: 520px;
    height: 420px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    SubDlgHeader {
        x: 0;
        y: 0;
        width: parent.width;
        title: Translation.tr("皮肤设置", Translation.language-gen);
        close => { root.cancel(); }
    }

    Text {
        x: 20px;
        y: 46px;
        width: 70px;
        height: 23px;
        text: Translation.tr("皮肤文件", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 90px;
        y: 42px;
        width: 300px;
        height: 214px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;
        clip: true;

        list-touch := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            scroll-event(event) => {
                root.scroll-offset = Math.max(0px, Math.min(root.max-offset, root.scroll-offset - (event.delta-y / 1px) * 1px));
                accept
            }
        }

        VerticalLayout {
            x: 1px;
            y: 2px - root.scroll-offset;
            width: parent.width - 2px;

            for row[idx] in root.rows : Rectangle {
                height: 22px;

                background: row.kind == 1 && row.index == root.selected
                    ? #d8e8ff
                    : (row.kind == 1 && row-touch.has-hover ? #eaf3ff : transparent);

                Text {
                    x: 8px;
                    y: 0;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: row.label;
                    color: row.kind == 0 ? #8a8a8a : (row.kind == 2 ? #9a9a9a : #1a1a1a);
                    font-size: row.kind == 0 ? 11px : 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                row-touch := TouchArea {
                    clicked => {
                        if (row.kind == 1) {
                            root.pick(row.index);
                        }
                    }
                    scroll-event(event) => {
                        root.scroll-offset = Math.max(0px, Math.min(root.max-offset, root.scroll-offset - (event.delta-y / 1px) * 1px));
                        accept
                    }
                }
            }
        }

        Rectangle {
            x: parent.width - 6px;
            y: 2px + (parent.height - 24px) * (root.scroll-offset / Math.max(1px, root.max-offset));
            width: 4px;
            height: root.max-offset <= 0px ? 0px : Math.max(24px, parent.height * parent.height / Math.max(1px, root.content-height));
            background: #b8b8b8;
            border-radius: 2px;
            visible: root.max-offset > 0px;
        }
    }

    SubDlgButton {
        x: 400px;
        y: 46px;
        width: 100px;
        label: Translation.tr("浏览...", Translation.language-gen);
        clicked => { root.browse(); }
    }

    Text {
        x: 20px;
        y: 274px;
        width: 70px;
        height: 23px;
        text: Translation.tr("不透明度", Translation.language-gen);
        color: #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 90px;
        y: 282px;
        width: 280px;
        height: 6px;
        background: #c9c9c9;
        border-radius: 3px;

        Rectangle {
            x: (parent.width - 10px) * (root.alpha - 0.4) / 0.6;
            y: -6px;
            width: 10px;
            height: 18px;
            background: #4a90d9;
            border-width: 1px;
            border-color: #2f6ea8;
            border-radius: 2px;
        }

        slider := TouchArea {
            x: 0px;
            y: -10px;
            width: parent.width;
            height: 26px;

            clicked => {
                root.opacity-changed(Math.min(1, Math.max(0.4, 0.4 + 0.6 * (self.mouse-x / self.width))));
            }

            moved => {
                if (self.pressed) {
                    root.opacity-changed(Math.min(1, Math.max(0.4, 0.4 + 0.6 * (self.mouse-x / self.width))));
                }
            }
        }
    }

    Text {
        x: 376px;
        y: 274px;
        width: 60px;
        height: 23px;
        text: Math.round(root.alpha * 100) + "%";
        color: #1a5fa8;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 304px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("不透明度作用于弹出菜单与子菜单；皮肤文件放在皮肤目录，或用“浏览...”载入。", Translation.language-gen);
        color: #6a6a6a;
        font-size: 11px;
        vertical-alignment: center;
    }

    SubDlgCheck {
        x: 20px;
        y: 334px;
        width: 160px;
        label: Translation.tr("视频下自动隐藏", Translation.language-gen);
        checked: root.autohide;
        toggled => { root.command("autohide-toggle"); }
    }

    SubDlgCheck {
        x: 200px;
        y: 334px;
        width: 170px;
        label: Translation.tr("全屏时不遮盖画面", Translation.language-gen);
        checked: root.no-cover;
        toggled => { root.command("fullscreen-no-cover-toggle"); }
    }

    Rectangle {
        x: 20px;
        y: 364px;
        width: parent.width - 40px;
        height: 1px;
        background: #c9c9c9;
    }

    SubDlgButton {
        x: parent.width - 190px;
        y: parent.height - 34px;
        width: 80px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.confirm(); }
    }

    SubDlgButton {
        x: parent.width - 100px;
        y: parent.height - 34px;
        width: 80px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.cancel(); }
    }
}
