import { Palette } from "theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";
import { Translation } from "translation.slint";

export struct DeviceEntry {
    title: string,
    subtitle: string,
}

export struct ResolutionEntry {
    title: string,
}

component SideTab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked;

    width: 26px;
    background: root.active ? #262626 : transparent;
    border-width: 1px;
    border-color: root.active ? #fae100 : transparent;

    Text {
        text: root.label;
        color: root.active ? #fae100 : #8a8a8a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component MenuButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    height: 26px;
    width: 78px;
    border-radius: 2px;
    background: !root.enabled ? #202020
        : (ta.has-hover ? (root.primary ? #fff04d : #343434) : (root.primary ? #fae100 : #262626));
    border-width: 1px;
    border-color: root.primary ? #fae100 : #3a3a3a;

    Text {
        text: root.label;
        color: !root.enabled ? #5c5c5c : (root.primary ? #101010 : #e2e2e2);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component DeviceMenu inherits Rectangle {
    in property <[DeviceEntry]> devices: [];
    in property <[ResolutionEntry]> resolutions: [];
    in property <[ResolutionEntry]> formats: [];
    in property <int> selected-device: -1;
    in property <int> selected-resolution: -1;
    in property <int> selected-format: -1;
    in-out property <string> network-url: "";
    in-out property <bool> network-mode: false;
    in property <bool> running: false;
    out property <bool> url-focus: url-edit.has-focus;

    callback device-picked(int);
    callback resolution-picked(int);
    callback format-picked(int);
    callback refresh;
    callback connect-network(string);
    callback start-requested;
    callback stop-requested;
    callback close-requested;

    background: #161616;
    border-width: 1px;
    border-color: #2f2f2f;
    clip: true;

    HorizontalLayout {
        spacing: 0px;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;

            Rectangle {
                height: 30px;
                background: transparent;

                Text {
                    x: 0;
                    y: 0;
                    width: parent.width - 60px;
                    height: parent.height;
                    text: Translation.tr("设备", Translation.language-gen);
                    color: #fae100;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                MenuButton {
                    x: parent.width - 78px;
                    y: 2px;
                    label: Translation.tr("刷新", Translation.language-gen);
                    clicked => { root.refresh(); }
                }
            }

            Rectangle {
                height: 1px;
                background: #2f2f2f;
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: Translation.tr("采集设备", Translation.language-gen);
                        color: #7a7a7a;
                        font-size: 11px;
                        visible: !root.network-mode;
                    }

                    if !root.network-mode && root.devices.length > 0 : VerticalLayout {
                        for entry[index] in root.devices : Rectangle {
                            height: 42px;
                            background: row-touch.has-hover || index == root.selected-device ? #242424 : transparent;

                            Rectangle {
                                x: 0;
                                y: 6px;
                                width: 2px;
                                height: parent.height - 12px;
                                background: index == root.selected-device ? #fae100 : transparent;
                            }

                            Text {
                                x: 8px;
                                y: 4px;
                                text: entry.title;
                                color: index == root.selected-device ? #fae100 : #dedede;
                                font-size: 12px;
                                overflow: elide;
                                width: parent.width - 16px;
                            }

                            Text {
                                x: 8px;
                                y: 22px;
                                text: entry.subtitle;
                                color: #7d7d7d;
                                font-size: 11px;
                                overflow: elide;
                                width: parent.width - 16px;
                            }

                            row-touch := TouchArea {
                                clicked => { root.device-picked(index); }
                            }
                        }
                    }

                    if !root.network-mode && root.devices.length == 0 : Text {
                        text: Translation.tr("无可用采集设备", Translation.language-gen);
                        color: #6f6f6f;
                        font-size: 11px;
                    }

                    if !root.network-mode && root.selected-device >= 0 : Text {
                        text: Translation.tr("分辨率", Translation.language-gen);
                        color: #7a7a7a;
                        font-size: 11px;
                    }

                    if !root.network-mode && root.selected-device >= 0 && root.resolutions.length > 0 : VerticalLayout {
                        for entry[index] in root.resolutions : Rectangle {
                            height: 26px;
                            background: size-touch.has-hover || index == root.selected-resolution ? #242424 : transparent;

                            Text {
                                x: 8px;
                                y: (parent.height - self.height) / 2;
                                text: entry.title;
                                color: index == root.selected-resolution ? #fae100 : #d0d0d0;
                                font-size: 12px;
                            }

                            size-touch := TouchArea {
                                clicked => { root.resolution-picked(index); }
                            }
                        }
                    }

                    if !root.network-mode && root.selected-device >= 0 && root.formats.length > 0 : Text {
                        text: Translation.tr("格式", Translation.language-gen);
                        color: #7a7a7a;
                        font-size: 11px;
                    }

                    if !root.network-mode && root.selected-device >= 0 && root.formats.length > 0 : VerticalLayout {
                        for entry[index] in root.formats : Rectangle {
                            height: 26px;
                            background: format-touch.has-hover || index == root.selected-format ? #242424 : transparent;

                            Text {
                                x: 8px;
                                y: (parent.height - self.height) / 2;
                                text: entry.title;
                                color: index == root.selected-format ? #fae100 : #d0d0d0;
                                font-size: 12px;
                            }

                            format-touch := TouchArea {
                                clicked => { root.format-picked(index); }
                            }
                        }
                    }

                    VerticalLayout {
                        visible: root.network-mode;
                        spacing: 6px;

                        Text {
                            text: Translation.tr("网络流", Translation.language-gen);
                            color: #7a7a7a;
                            font-size: 11px;
                        }

                        url-edit := LineEdit {
                            text <=> root.network-url;
                            placeholder-text: "rtsp:// / udp:// / rtp://";
                            height: 28px;
                            font-size: 12px;
                        }

                        MenuButton {
                            label: Translation.tr("连接", Translation.language-gen);
                            clicked => { root.connect-network(root.network-url); }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #2f2f2f;
            }

            HorizontalLayout {
                spacing: 6px;

                MenuButton {
                    label: root.running ? Translation.tr("停止", Translation.language-gen) : Translation.tr("启动", Translation.language-gen);
                    primary: !root.running;
                    clicked => {
                        if (root.running) {
                            root.stop-requested();
                        } else {
                            root.start-requested();
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                MenuButton {
                    label: Translation.tr("关闭", Translation.language-gen);
                    clicked => { root.close-requested(); }
                }
            }
        }

        Rectangle {
            width: 26px;
            background: #1b1b1b;
            border-width: 1px;
            border-color: #2a2a2a;

            VerticalLayout {
                spacing: 0px;

                SideTab {
                    label: Translation.tr("设\n备", Translation.language-gen);
                    active: !root.network-mode;
                    clicked => { root.network-mode = false; }
                }

                SideTab {
                    label: Translation.tr("网\n络", Translation.language-gen);
                    active: root.network-mode;
                    clicked => { root.network-mode = true; url-edit.focus(); }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
