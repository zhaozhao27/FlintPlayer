import { Translation } from "translation.slint";

component DlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component CaptureSizeDialog inherits Rectangle {
    in property <bool> active: false;
    in property <int> slot: 1;
    in property <string> heading: "";
    in-out property <string> width-text: "1280";
    in-out property <string> height-text: "720";
    callback apply;
    callback close;

    width: 300px;
    height: 176px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: root.heading == "" ? (Translation.tr("截屏", Translation.language-gen) + " " + root.slot + Translation.tr(" 尺寸设置", Translation.language-gen)) : root.heading;
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: parent.width - 40px;
            width: 40px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Text {
        x: 16px;
        y: 44px;
        width: 44px;
        height: 22px;
        text: Translation.tr("宽：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 64px;
        y: 44px;
        width: 90px;
        height: 22px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        width-edit := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text <=> root.width-text;
            font-size: 11px;
            color: #1a1a1a;
            single-line: true;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.close();
                    accept
                } else {
                    reject
                }
            }
        }
    }

    Text {
        x: 16px;
        y: 76px;
        width: 44px;
        height: 22px;
        text: Translation.tr("高：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 64px;
        y: 76px;
        width: 90px;
        height: 22px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        height-edit := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text <=> root.height-text;
            font-size: 11px;
            color: #1a1a1a;
            single-line: true;
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.close();
                    accept
                } else {
                    reject
                }
            }
        }
    }

    Text {
        x: 16px;
        y: 104px;
        width: parent.width - 32px;
        height: 18px;
        text: Translation.tr("单位为像素，范围 16 - 8192。", Translation.language-gen);
        color: #6a6a6a;
        font-size: 10px;
        vertical-alignment: center;
    }

    changed active => {
        if (self.active) {
            width-edit.focus();
        }
    }

    DlgButton {
        x: parent.width - 176px;
        y: parent.height - 34px;
        width: 76px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 34px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}
