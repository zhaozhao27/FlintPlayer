import { ScrollView } from "std-widgets.slint";
import { Translation } from "translation.slint";

export struct SearchRow {
    label: string,
    hint: string,
}

component DlgButton inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    height: 23px;
    background: ta.has-hover ? #e6e6e6 : #f4f4f4;
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MenuSearchDialog inherits Rectangle {
    in property <bool> active: false;
    in property <[SearchRow]> rows: [];
    in-out property <int> selected: -1;
    callback searched(string);
    callback picked(int);
    callback close;

    width: 460px;
    height: 440px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: Translation.tr("简索菜单", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            x: parent.width - 40px;
            width: 40px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: 8px;
        y: 34px;
        width: parent.width - 16px;
        height: 24px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        search-edit := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            font-size: 11px;
            color: #1a1a1a;
            single-line: true;
            edited => { root.searched(search-edit.text); }
            key-pressed(event) => {
                if (event.text == "\u{1b}" || (event.modifiers.control && (event.text == "\u{f70f}" || event.text == "\u{F70F}"))) {
                    root.close();
                    accept
                } else {
                    reject
                }
            }
            accepted => {
                if (root.selected >= 0) {
                    root.picked(root.selected);
                } else if (root.rows.length > 0) {
                    root.picked(0);
                }
            }
        }
    }

    changed active => {
        if (self.active) {
            search-edit.text = "";
            search-edit.focus();
            root.selected = -1;
        }
    }

    Rectangle {
        x: 8px;
        y: 64px;
        width: parent.width - 16px;
        height: parent.height - 64px - 40px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;
        clip: true;

        ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;

            VerticalLayout {
                for row[index] in root.rows : Rectangle {
                    height: 24px;

                    background: index == root.selected ? #cfe4f7 : (row-touch.has-hover ? #e8f2fb : transparent);

                    Text {
                        x: 8px;
                        y: 0;
                        width: parent.width - 130px;
                        height: parent.height;
                        text: row.label;
                        color: #1a1a1a;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - 120px;
                        y: 0;
                        width: 112px;
                        height: parent.height;
                        text: row.hint;
                        color: #7a7a7a;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.selected = index;
                            root.picked(index);
                        }
                    }
                }
            }
        }
    }

    DlgButton {
        x: parent.width - 84px;
        y: parent.height - 32px;
        width: 76px;
        label: Translation.tr("关闭", Translation.language-gen);
        clicked => { root.close(); }
    }
}
