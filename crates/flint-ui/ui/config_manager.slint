import { Translation } from "translation.slint";
component ConfigButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    height: 24px;
    background: !root.enabled
        ? #ececec
        : (root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4));
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

export component ConfigManager inherits Rectangle {
    in property <[string]> profiles: [];
    in-out property <int> selected: 0;
    in property <string> status: "";
    in-out property <string> rename-text: "";
    callback picked(int);
    callback load-config;
    callback create-config;
    callback rename-config(string);
    callback delete-config;
    callback close;

    width: 540px;
    height: 360px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 46px;
            height: parent.height;
            text: Translation.tr("配置管理", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: 16px;
        y: 40px;
        width: 336px;
        height: 252px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            alignment: start;
            spacing: 0px;

            for profile[index] in root.profiles : Rectangle {
                width: parent.width;
                height: 24px;
                background: index == root.selected
                    ? #cfe6ff
                    : (row-ta.has-hover ? #e8f1fb : transparent);

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: profile;
                    color: #1a1a1a;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                row-ta := TouchArea {
                    clicked => {
                        root.selected = index;
                        root.picked(index);
                    }
                }
            }
        }
    }

    Rectangle {
        x: 16px;
        y: 300px;
        width: 336px;
        height: 24px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        input := TextInput {
            x: 6px;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.rename-text;
            color: #1a1a1a;
            font-size: 11px;
            single-line: true;
            accepted => { root.rename-config(input.text); }
        }
    }

    Text {
        x: 16px;
        y: 330px;
        width: 336px;
        height: 18px;
        text: root.status;
        color: #4a4a4a;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    ConfigButton {
        x: 364px;
        y: 40px;
        width: 160px;
        label: Translation.tr("载入", Translation.language-gen);
        primary: true;
        clicked => { root.load-config(); }
    }

    ConfigButton {
        x: 364px;
        y: 72px;
        width: 160px;
        label: Translation.tr("新建（复制当前配置）", Translation.language-gen);
        clicked => { root.create-config(); }
    }

    ConfigButton {
        x: 364px;
        y: 104px;
        width: 160px;
        label: Translation.tr("重命名", Translation.language-gen);
        enabled: root.selected > 0;
        clicked => { root.rename-config(input.text); }
    }

    ConfigButton {
        x: 364px;
        y: 136px;
        width: 160px;
        label: Translation.tr("删除", Translation.language-gen);
        enabled: root.selected > 0;
        clicked => { root.delete-config(); }
    }

    ConfigButton {
        x: 364px;
        y: 326px;
        width: 160px;
        label: Translation.tr("关闭", Translation.language-gen);
        clicked => { root.close(); }
    }
}
