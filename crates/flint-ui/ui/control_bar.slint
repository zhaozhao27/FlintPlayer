import { Glyph } from "icons.slint";

component Chip inherits Rectangle {
    in property <string> text: "";
    in property <length> chip-width: 48px;
    in property <color> text-color: #a8a8a8;

    width: root.chip-width;
    height: 18px;
    border-radius: 2px;
    background: #262626;
    border-width: 1px;
    border-color: #3a3a3a;

    Text {
        text: root.text;
        color: root.text-color;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: elide;
    }
}

component BarButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <color> tint: #d0d0d0;
    in property <bool> divider: true;
    callback clicked;

    width: 38px;
    background: touch.has-hover && root.enabled ? #232323 : transparent;

    Rectangle {
        x: parent.width - 1px;
        y: (parent.height - 24px) / 2;
        width: 1px;
        height: 24px;
        background: #333333;
        visible: root.divider;
    }

    Glyph {
        kind: root.kind;
        tint: root.enabled ? root.tint : #5a5a5a;
        width: 13px;
        height: 13px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ClusterButton inherits Rectangle {
    in property <int> kind: -1;
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <color> tint: #cfcfcf;
    callback clicked;

    width: 32px;
    background: touch.has-hover && root.enabled ? #232323 : transparent;

    Glyph {
        visible: root.kind >= 0;
        kind: root.kind;
        tint: root.enabled ? root.tint : #5a5a5a;
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    Text {
        visible: root.kind < 0;
        text: root.label;
        color: root.enabled ? root.tint : #5a5a5a;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ControlBar inherits Rectangle {
    in property <bool> running: false;
    in property <bool> paused: false;
    in property <bool> recording: false;
    in property <bool> frozen: false;
    in property <bool> osd-visible: false;
    in property <bool> menu-open: false;
    in property <bool> fullscreen: false;
    in property <bool> sidebar-open: false;
    in property <float> progress: 0;
    in property <[float]> bookmarks: [];
    in property <[float]> chapters: [];
    in property <float> volume: 1;
    in property <bool> muted: false;
    in property <string> elapsed: "00:00:00";
    in property <string> duration: "00:00:00";
    in property <string> seek-hover-time: "";
    in property <string> codec: "";
    in property <string> size: "";
    in property <string> rate: "";
    in property <string> bitrate: "";
    in property <string> source: "";
    in property <color> accent: #4aa3ff;

    callback main-menu;
    callback settings-requested;
    callback play-pause;
    callback stop-requested;
    callback previous-panel;
    callback next-panel;
    callback open-requested;
    callback toggle-sidebar;
    callback activity;
    callback right-clicked(length, length);
    callback seek-requested(float);
    callback seek-preview(float);
    callback volume-requested(float);
    callback toggle-mute;

    height: 62px;
    background: #1b1b1b;
    clip: true;

    Rectangle {
        y: 0;
        width: parent.width;
        height: 1px;
        background: #3a3a3a;
    }

    background-touch := TouchArea {
        moved => { root.activity(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.right-clicked(background-touch.mouse-x, background-touch.mouse-y);
            }
        }
    }

    seek-touch := TouchArea {
        x: 8px;
        y: 0;
        width: Math.max(0px, parent.width - 96px);
        height: 20px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.seek-preview(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
            }
            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                root.seek-requested(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
            }
        }
    }

    Rectangle {
        x: 8px;
        y: 9px;
        width: seek-touch.width;
        height: 2px;
        background: #4a4a4a;
    }

    Rectangle {
        x: 8px;
        y: 9px;
        width: seek-touch.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: 2px;
        background: #e5c100;
    }

    for marker in root.chapters: Rectangle {
        x: 8px + seek-touch.width * Math.max(0.0, Math.min(1.0, marker)) - 1px;
        y: 5px;
        width: 2px;
        height: 10px;
        background: #9a9a9a;
    }

    for marker in root.bookmarks: Rectangle {
        x: 8px + seek-touch.width * Math.max(0.0, Math.min(1.0, marker)) - 1px;
        y: 4px;
        width: 3px;
        height: 12px;
        background: root.accent;
    }

    Rectangle {
        x: 8px + seek-touch.width * Math.max(0.0, Math.min(1.0, root.progress)) - 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #ffffff;
    }

    Rectangle {
        visible: seek-touch.has-hover && root.seek-hover-time != "";
        x: Math.max(0px, Math.min(parent.width - self.width - 2px, seek-touch.mouse-x - self.width / 2));
        y: 2px;
        width: Math.max(48px, hover-time-text.preferred-width + 12px);
        height: 16px;
        background: #000000d8;
        border-width: 1px;
        border-color: #6a6a6a;
        border-radius: 2px;

        hover-time-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.seek-hover-time;
            color: #f2f2f2;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Glyph {
        kind: root.muted ? 11 : 10;
        tint: #c8c8c8;
        width: 13px;
        height: 13px;
        x: parent.width - 76px;
        y: 4px;
    }

    Rectangle {
        x: parent.width - 76px;
        y: 0;
        width: 76px;
        height: 20px;
        background: transparent;

        TouchArea {
            clicked => { root.toggle-mute(); }
        }
    }

    volume-touch := TouchArea {
        x: parent.width - 56px;
        y: 0;
        width: 48px;
        height: 20px;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                root.volume-requested(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
            }
        }
    }

    Rectangle {
        x: parent.width - 56px;
        y: 9px;
        width: 48px;
        height: 2px;
        background: #4a4a4a;
    }

    Rectangle {
        x: parent.width - 56px;
        y: 9px;
        width: 48px * Math.max(0.0, Math.min(1.0, root.muted ? 0.0 : root.volume));
        height: 2px;
        background: #e5c100;
    }

    Rectangle {
        x: parent.width - 56px + 48px * Math.max(0.0, Math.min(1.0, root.muted ? 0.0 : root.volume)) - 4px;
        y: 6px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
    }

    HorizontalLayout {
        y: 20px;
        height: 42px;
        padding-left: 0px;
        padding-right: 4px;
        spacing: 0px;

        BarButton {
            kind: root.paused ? 0 : 1;
            enabled: root.running;
            clicked => { root.play-pause(); }
        }

        BarButton {
            kind: 2;
            enabled: root.running;
            clicked => { root.stop-requested(); }
        }

        BarButton {
            kind: 4;
            clicked => { root.previous-panel(); }
        }

        BarButton {
            kind: 3;
            clicked => { root.next-panel(); }
        }

        BarButton {
            kind: 30;
            clicked => { root.open-requested(); }
        }

        Rectangle { width: 10px; }

        Text {
            text: root.elapsed + " / " + root.duration;
            color: #c8c8c8;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle { width: 12px; }

        Chip {
            text: "S/W";
            chip-width: 34px;
            text-color: #9a9a9a;
        }

        Rectangle { width: 4px; }

        Chip {
            text: root.codec;
            chip-width: 46px;
            visible: root.codec != "";
        }

        Chip {
            text: root.size;
            chip-width: 74px;
            visible: root.size != "" && root.width > 600px;
        }

        Chip {
            text: root.rate;
            chip-width: 52px;
            visible: root.rate != "" && root.width > 660px;
        }

        Chip {
            text: root.bitrate;
            chip-width: 62px;
            visible: root.bitrate != "" && root.width > 740px;
        }

        Rectangle { horizontal-stretch: 1; }

        ClusterButton {
            kind: -1;
            label: "360°";
            enabled: false;
        }

        ClusterButton {
            kind: -1;
            label: "3D";
            enabled: false;
        }

        ClusterButton {
            kind: 6;
            enabled: false;
        }

        ClusterButton {
            kind: 27;
            tint: root.sidebar-open ? #f0c93c : #cfcfcf;
            clicked => { root.toggle-sidebar(); }
        }

        ClusterButton {
            kind: 31;
            tint: #cfcfcf;
            clicked => { root.settings-requested(); }
        }

        ClusterButton {
            kind: 9;
            clicked => { root.main-menu(); }
        }
    }
}
