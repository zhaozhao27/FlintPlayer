import { Glyph } from "icons.slint";
import { Translation } from "translation.slint";

component AboutButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AboutDialog inherits Rectangle {
    in property <string> version: "";
    callback close;

    width: 460px;
    height: 272px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    TouchArea {
        clicked => { }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: Translation.tr("关于 FlintPlayer", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            x: parent.width - 36px;
            y: 0;
            width: 36px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: 20px;
        y: 46px;
        width: 64px;
        height: 64px;
        border-radius: 8px;
        background: @linear-gradient(135deg, #3a8fd9 0%, #1f5fa8 100%);
        border-width: 1px;
        border-color: #17497f;

        Glyph {
            kind: 0;
            tint: #ffffff;
            width: 32px;
            height: 32px;
            x: (parent.width - self.width) / 2 + 2px;
            y: (parent.height - self.height) / 2;
        }
    }

    Text {
        x: 100px;
        y: 46px;
        width: parent.width - 120px;
        height: 28px;
        text: "FlintPlayer";
        color: #1a1a1a;
        font-size: 19px;
        font-weight: 700;
        vertical-alignment: center;
    }

    Text {
        x: 100px;
        y: 74px;
        width: parent.width - 120px;
        height: 18px;
        text: Translation.tr("版本 ", Translation.language-gen) + root.version;
        color: #4a4a4a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 100px;
        y: 92px;
        width: parent.width - 120px;
        height: 18px;
        text: Translation.tr("Linux 上的 PotPlayer 风格媒体播放器", Translation.language-gen);
        color: #4a4a4a;
        font-size: 12px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 20px;
        y: 126px;
        width: parent.width - 40px;
        height: 1px;
        background: #c9c9c9;
    }

    Text {
        x: 20px;
        y: 138px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("基于 Rust、Slint 与 FFmpeg 构建。", Translation.language-gen);
        color: #333333;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 158px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("支持本地媒体文件、网络串流与采集设备。", Translation.language-gen);
        color: #333333;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 178px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("FFmpeg 遵循 LGPL/GPL 许可协议；Slint 遵循 GPL/商业许可。", Translation.language-gen);
        color: #333333;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 20px;
        y: 200px;
        width: parent.width - 40px;
        height: 18px;
        text: Translation.tr("Copyright © 2026 FlintPlayer Project. 保留所有权利。", Translation.language-gen);
        color: #6a6a6a;
        font-size: 11px;
        vertical-alignment: center;
    }

    AboutButton {
        x: parent.width - 100px;
        y: parent.height - 34px;
        width: 80px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.close(); }
    }
}
