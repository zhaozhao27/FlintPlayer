import { Translation } from "translation.slint";

component DlgButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    callback clicked;

    height: 23px;
    background: root.primary ? (ta.has-hover ? #d8ecff : #e7f3ff) : (ta.has-hover ? #e6e6e6 : #f4f4f4);
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component DlgCheck inherits Rectangle {
    in property <string> label: "";
    in-out property <bool> checked: false;
    callback toggled;

    height: 22px;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;

        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.checked ? "✓" : "";
            color: #1a1a1a;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 20px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component NavigationSettingsDialog inherits Rectangle {
    in property <bool> active: false;
    in-out property <string> seek-step: "5";
    in-out property <bool> remember-position: true;
    in-out property <bool> show-markers: true;
    in-out property <bool> autohide-controls: true;
    callback apply;
    callback close;

    width: 400px;
    height: 240px;
    background: #f0f0f0;
    border-width: 1px;
    border-color: #6a6a6a;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: #1f1f1f;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 50px;
            height: parent.height;
            text: Translation.tr("简索设置", Translation.language-gen);
            color: #eeeeee;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: parent.width - 30px;
            y: 0;
            width: 20px;
            height: parent.height;
            text: "✕";
            color: #d0d0d0;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            x: parent.width - 40px;
            width: 40px;
            height: parent.height;
            clicked => { root.close(); }
        }
    }

    TouchArea {
        y: 28px;
        height: parent.height - 28px;
        clicked => { }
    }

    Text {
        x: 16px;
        y: 44px;
        width: 150px;
        height: 22px;
        text: Translation.tr("快进/快退步长（秒）：", Translation.language-gen);
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: 180px;
        y: 44px;
        width: 80px;
        height: 22px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8f8f8f;

        step-edit := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: root.seek-step;
            font-size: 11px;
            color: #1a1a1a;
            single-line: true;
            edited => { root.seek-step = step-edit.text; }
            key-pressed(event) => {
                if (event.text == "\u{1b}") {
                    root.close();
                    accept
                } else {
                    reject
                }
            }
        }
    }

    DlgCheck {
        x: 16px;
        y: 82px;
        width: parent.width - 32px;
        label: Translation.tr("记住播放位置", Translation.language-gen);
        checked <=> root.remember-position;
    }

    DlgCheck {
        x: 16px;
        y: 110px;
        width: parent.width - 32px;
        label: Translation.tr("在进度条上显示书签/章节标记", Translation.language-gen);
        checked <=> root.show-markers;
    }

    DlgCheck {
        x: 16px;
        y: 138px;
        width: parent.width - 32px;
        label: Translation.tr("自动隐藏控制栏", Translation.language-gen);
        checked <=> root.autohide-controls;
    }

    changed active => {
        if (self.active) {
            step-edit.focus();
        }
    }

    DlgButton {
        x: parent.width - 176px;
        y: parent.height - 34px;
        width: 76px;
        label: Translation.tr("确定", Translation.language-gen);
        primary: true;
        clicked => { root.apply(); }
    }

    DlgButton {
        x: parent.width - 92px;
        y: parent.height - 34px;
        width: 76px;
        label: Translation.tr("取消", Translation.language-gen);
        clicked => { root.close(); }
    }
}
