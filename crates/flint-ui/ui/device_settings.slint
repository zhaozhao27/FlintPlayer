import { Translation } from "translation.slint";
export component Dropdown inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> selected: -1;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback picked(int);

    height: 22px;
    background: root.enabled ? #ffffff : #ececec;
    border-width: 1px;
    border-color: #9a9a9a;

    Text {
        x: 5px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : root.placeholder;
        color: !root.enabled ? #9a9a9a : (root.selected >= 0 ? #1a1a1a : #b0b0b0);
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 17px;
        width: 11px;
        height: parent.height;
        text: "▾";
        color: root.enabled ? #555555 : #b0b0b0;
        font-size: 10px;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            if (popup.is-open) {
                popup.close();
            } else {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: root.options.length * 20px + 2px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #ffffff;
            border-width: 1px;
            border-color: #8f8f8f;

            for option[index] in root.options : Rectangle {
                y: index * 20px + 1px;
                height: 20px;
                width: 100%;
                background: option-touch.has-hover ? #3a8fd9 : transparent;

                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: option;
                    color: option-touch.has-hover ? #ffffff : #1a1a1a;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                option-touch := TouchArea {
                    clicked => {
                        root.selected = index;
                        root.picked(index);
                        popup.close();
                    }
                }
            }
        }
    }
}

component Combo inherits Rectangle {
    in property <string> value: "";
    in property <bool> enabled: true;
    in property <string> placeholder: "";

    height: 22px;
    background: root.enabled ? #ffffff : #ececec;
    border-width: 1px;
    border-color: #9a9a9a;

    Text {
        x: 5px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.value != "" ? root.value : root.placeholder;
        color: !root.enabled ? #9a9a9a : (root.value != "" ? #1a1a1a : #b0b0b0);
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 17px;
        width: 11px;
        height: parent.height;
        text: "▾";
        color: root.enabled ? #555555 : #b0b0b0;
        font-size: 10px;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
    }
}

component Spin inherits Rectangle {
    in property <int> value: 0;

    height: 22px;
    background: #ffffff;
    border-width: 1px;
    border-color: #9a9a9a;

    Text {
        x: 6px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.value;
        color: #1a1a1a;
        font-size: 11px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 14px;
        y: 1px;
        width: 13px;
        height: parent.height / 2 - 1px;
        background: #f2f2f2;
        border-width: 1px;
        border-color: #cfcfcf;

        Text {
            text: "▴";
            color: #555555;
            font-size: 7px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    Rectangle {
        x: parent.width - 14px;
        y: parent.height / 2;
        width: 13px;
        height: parent.height / 2 - 1px;
        background: #f2f2f2;
        border-width: 1px;
        border-color: #cfcfcf;

        Text {
            text: "▾";
            color: #555555;
            font-size: 7px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

component Check inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label: "";
    in property <bool> enabled: true;

    height: 18px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 2px;
        width: 13px;
        height: 13px;
        background: root.enabled ? #ffffff : #ececec;
        border-width: 1px;
        border-color: root.enabled ? #7a7a7a : #bcbcbc;
    }

    Text {
        x: 1px;
        y: 2px;
        width: 11px;
        height: 13px;
        text: "✓";
        color: root.enabled ? #1a5fb4 : #9a9a9a;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: root.checked;
    }

    Text {
        x: 18px;
        y: 0;
        width: parent.width - 18px;
        height: parent.height;
        text: root.label;
        color: root.enabled ? #1a1a1a : #9a9a9a;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; }
    }
}

component Group inherits Rectangle {
    in property <string> title: "";
    @children

    background: transparent;
    border-width: 1px;
    border-color: #b8b8b8;

    Text {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 18px;
        text: root.title;
        color: #1c1c1c;
        font-size: 11px;
        vertical-alignment: center;
    }
}

component FieldLabel inherits Text {
    width: 82px;
    height: 22px;
    horizontal-alignment: right;
    vertical-alignment: center;
    color: #1a1a1a;
    font-size: 11px;
}

component DlgButton inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    height: 23px;
    background: ta.has-hover ? #e6e6e6 : #f4f4f4;
    border-width: 1px;
    border-color: #8f8f8f;
    border-radius: 2px;

    Text {
        text: root.label;
        color: #1a1a1a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked;

    height: 26px;
    background: root.active ? #f5f5f5 : #e3e3e3;
    border-width: 1px;
    border-color: #a0a0a0;

    Text {
        text: root.label;
        color: root.active ? #111111 : #3a3a3a;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component DeviceSettings inherits Rectangle {
