                title: Translation.tr("其他", Translation.language-gen);

                Check { x: 14px; y: 28px; width: 300px; label: Translation.tr("暂不支持该 EPG。", Translation.language-gen); enabled: false; }
            }
        }

        Rectangle {
            visible: root.tab == 4;
