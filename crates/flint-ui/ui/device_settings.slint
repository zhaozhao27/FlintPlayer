    in property <int> capture-height: 720;
    in property <int> capture-fps: 30;
    in property <bool> audio-loopback: false;
    in property <[string]> device-names: [];
    in-out property <int> device-index: -1;
    in property <[string]> format-names: [];
    in-out property <int> format-index: -1;

