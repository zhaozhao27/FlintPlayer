                Combo { x: 100px; y: 104px; width: 340px; value: ""; enabled: false; }

                Check { x: 100px; y: 132px; width: 320px; label: Translation.tr("使用 Microsoft 默认调谐器", Translation.language-gen); enabled: false; }
                Check { x: 100px; y: 152px; width: 320px; label: Translation.tr("使用新的连接方式(推荐)", Translation.language-gen); checked: true; enabled: false; }
            }

